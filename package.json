{
  "name": "agent-browser-studio",
  "version": "1.0.0",
  "description": "Local-first browser profile management and AI automation studio for independently patched Chromium",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "clean:build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "clean:release": "node -e \"require('fs').rmSync('release', { recursive: true, force: true })\"",
    "build": "npm run clean:build && tsc && mkdir -p dist/renderer dist/resources && cp -r src/renderer/index.html src/renderer/storage-migrate.html src/renderer/css src/renderer/js dist/renderer/ && cp src/main/preload.cjs dist/main/ && cp resources/tray-icon-Template.png dist/resources/ && cp resources/icon.icns dist/resources/ && npm run build:native",
    "build:native": "node scripts/build-masque-bridge.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "dist": "npm run build && npm run clean:release && electron-builder",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npm run build && vitest run -c vitest.config.e2e.ts",
    "check:i18n": "node scripts/check-i18n.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "check:size": "node scripts/check-file-size.mjs",
    "check": "npm run check:i18n && npm run check:size",
    "test:e2e:j1": "vitest run -c vitest.config.e2e.ts tests/e2e/j1-profile-launch.test.ts",
    "test:e2e:j2": "vitest run -c vitest.config.e2e.ts tests/e2e/j2-batch-profiles.test.ts",
    "test:e2e:j3": "vitest run -c vitest.config.e2e.ts tests/e2e/j3-extensions.test.ts",
    "test:e2e:j4": "vitest run -c vitest.config.e2e.ts tests/e2e/j4-agent-stream.test.ts",
    "verify:chromium": "npm run build && node dist/tools/verify-native-chromium.js",
    "verify:network": "npm run build && node dist/tools/verify-network-fingerprint.js",
    "verify:proxy": "npm run build && node dist/tools/verify-proxy-routing.js",
    "verify:ping0": "npm run build && node dist/tools/verify-ping0.js",
    "compare:roxy": "npm run build && node dist/tools/compare-roxy-ping0.js",
    "install:chromium": "npm run build && node dist/tools/install-native-chromium.js",
    "pretest": "npm run build",
    "postinstall": "electron-builder install-app-deps"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.8",
    "electron": "42.4.0",
    "electron-builder": "^26.15.3",
    "marked": "^18.0.5",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  },
  "author": "ahoo",
  "license": "MIT",
  "dependencies": {
    "mmdb-lib": "^3.0.2",
    "qrcode": "^1.5.4",
    "socks": "^2.8.9",
    "socks-proxy-agent": "^10.1.0",
    "ws": "^8.21.0"
  }
}
