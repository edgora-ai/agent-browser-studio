{
  "name": "cloak-lite",
  "version": "1.0.0",
  "description": "Open-source CloakBrowser fingerprint browser management console",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "clean:build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "clean:release": "node -e \"require('fs').rmSync('release', { recursive: true, force: true })\"",
    "build": "npm run clean:build && tsc && mkdir -p dist/renderer dist/resources && cp -r src/renderer/index.html src/renderer/css src/renderer/js dist/renderer/ && cp src/main/preload.cjs dist/main/ && cp resources/tray-icon-Template.png dist/resources/ && cp resources/icon.icns dist/resources/",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "dist": "npm run build && npm run clean:release && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && vitest run -c vitest.config.e2e.ts",
    "test:e2e:j1": "vitest run -c vitest.config.e2e.ts tests/e2e/j1-profile-launch.test.ts",
    "test:e2e:j2": "vitest run -c vitest.config.e2e.ts tests/e2e/j2-batch-profiles.test.ts",
    "test:e2e:j3": "vitest run -c vitest.config.e2e.ts tests/e2e/j3-extensions.test.ts",
    "test:e2e:j4": "vitest run -c vitest.config.e2e.ts tests/e2e/j4-agent-stream.test.ts",
    "verify:chromium": "npm run build && node dist/tools/verify-native-chromium.js",
    "verify:proxy": "npm run build && node dist/tools/verify-proxy-routing.js",
    "install:chromium": "npm run build && node dist/tools/install-native-chromium.js",
    "pretest": "npm run build",
    "postinstall": "electron-builder install-app-deps"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "marked": "^18.0.5",
    "playwright": "^1.61.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  },
  "author": "ahoo",
  "license": "MIT",
  "dependencies": {
    "cloakbrowser": "https://github.com/edgora-ai/CloakBrowser/archive/18180fad1600b4f3c57a0efa3c175961ac01fb8e.tar.gz",
    "mmdb-lib": "^3.0.2",
    "socks": "^2.8.9",
    "socks-proxy-agent": "^10.1.0",
    "ws": "^8.21.0"
  }
}
