@@ -0,0 +1,93 @@
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_PUBLIC_COMMON_NAVIGATION_PRODUCT_STANDALONE_SCOPE_H_
+#define THIRD_PARTY_BLINK_PUBLIC_COMMON_NAVIGATION_PRODUCT_STANDALONE_SCOPE_H_
+
+#include <cstddef>
+#include <string_view>
+
+#include "url/gurl.h"
+
+namespace blink {
+
+inline constexpr size_t kMaxProductStandaloneUrlLength = 4096;
+
+inline bool IsSafeProductStandaloneUrl(const GURL& url) {
+  if (!url.is_valid() || !url.SchemeIs("https") || !url.has_host() ||
+      url.has_username() || url.has_password() || url.IntPort() == 0 ||
+      url.spec().size() > kMaxProductStandaloneUrlLength) {
+    return false;
+  }
+  for (const unsigned char c : url.spec()) {
+    if (c <= ' ' || c >= 0x7f) {
+      return false;
+    }
+  }
+
+  // Match on the canonical escaped path, never a decoded path. Reject
+  // separators, NUL, and nested escapes before applying the slash boundary.
+  // Chromium may already have removed dot segments while parsing the URL.
+  const auto path = url.path();
+  if (!path.starts_with('/')) {
+    return false;
+  }
+  auto hex = [](char c) -> int {
+    if (c >= '0' && c <= '9') {
+      return c - '0';
+    }
+    c |= 0x20;
+    return c >= 'a' && c <= 'f' ? c - 'a' + 10 : -1;
+  };
+  size_t dots = 0;
+  bool segment_is_all_dots = true;
+  for (size_t i = 1; i <= path.size(); ++i) {
+    if (i == path.size() || path[i] == '/') {
+      if (segment_is_all_dots && (dots == 1 || dots == 2)) {
+        return false;
+      }
+      dots = 0;
+      segment_is_all_dots = true;
+      continue;
+    }
+    int c = path[i];
+    if (c == '%') {
+      if (i + 2 >= path.size()) {
+        return false;
+      }
+      const int high = hex(path[i + 1]);
+      const int low = hex(path[i + 2]);
+      if (high < 0 || low < 0) {
+        return false;
+      }
+      c = high * 16 + low;
+      i += 2;
+      if (c == '/' || c == '\\' || c == '\0' || c == '%') {
+        return false;
+      }
+    }
+    segment_is_all_dots &= c == '.';
+    dots += c == '.';
+  }
+  return true;
+}
+
+inline bool IsProductStandaloneScope(const GURL& scope) {
+  return IsSafeProductStandaloneUrl(scope) && !scope.has_query() &&
+         !scope.has_ref();
+}
+
+inline bool IsUrlInProductStandaloneScope(const GURL& url, const GURL& scope) {
+  if (!IsProductStandaloneScope(scope) || !IsSafeProductStandaloneUrl(url) ||
+      url.host() != scope.host() || url.IntPort() != scope.IntPort()) {
+    return false;
+  }
+  const std::string_view limit = scope.path();
+  const std::string_view path = url.path();
+  return path == limit || (path.starts_with(limit) &&
+                          (limit.ends_with('/') || path[limit.size()] == '/'));
+}
