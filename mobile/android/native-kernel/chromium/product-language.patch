+std::string ShellContentBrowserClient::GetApplicationLocale() {
+#if BUILDFLAG(IS_ANDROID)
+  const auto* command = base::CommandLine::ForCurrentProcess();
+  if (command->HasSwitch(kAgentBrowserProductProfileSwitch)) {
+    // The product freezes --lang before native startup. Content uses this
+    // locale to set renderer --lang, rather than copying the browser switch.
+    return command->GetSwitchValueASCII(switches::kLang);
+  }
+#endif
+  return ContentBrowserClient::GetApplicationLocale();
+}
+
 std::string ShellContentBrowserClient::GetAcceptLangs(BrowserContext* context) {
   return GetShellLanguage();
+}
+
+void ShellContentBrowserClient::UpdateRendererPreferencesForWorker(
+    BrowserContext* browser_context,
+    blink::RendererPreferences* out_prefs) {
+  ContentBrowserClient::UpdateRendererPreferencesForWorker(browser_context,
+                                                         out_prefs);
+#if BUILDFLAG(IS_ANDROID)
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          kAgentBrowserProductProfileSwitch)) {
+    // Shared and service workers do not inherit a frame's preferences.
+    out_prefs->accept_languages = GetShellLanguage();
+  }
+#endif
 }
 
