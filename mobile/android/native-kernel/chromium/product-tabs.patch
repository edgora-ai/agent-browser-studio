+    private void detachShell(Shell shellView) {
+        WebContents contents = shellView.getWebContents();
+        if (contents != null) contents.updateWebContentsVisibility(Visibility.HIDDEN);
+        if (shellView == mActiveShell) mActiveShell = null;
+        if (shellView.getParent() == null) return;
+        shellView.setContentViewRenderView(null);
+        removeView(shellView);
+    }
+
+    /** Opens a URL in a new tab without closing existing tabs. */
+    public void launchShellInNewTab(String url) {
+        ThreadUtils.assertOnUiThread();
+        ShellManagerJni.get().launchShell(url);
+    }
+
+    /** All live shells (tabs); the active tab is not guaranteed to be last. */
+    public List<Shell> getShells() {
+        return new ArrayList<>(mShells);
+    }
+
+    /** Switches to an existing shell without destroying the current one. */
+    public void selectShell(Shell shell) {
+        ThreadUtils.assertOnUiThread();
+        if (shell == mActiveShell || !mShells.contains(shell)) return;
+        if (mActiveShell != null) detachShell(mActiveShell);
+        showShell(shell);
+    }
+
+    /** Closes one tab and activates the last remaining tab, if any. */
+    public void closeShell(Shell shell) {
+        ThreadUtils.assertOnUiThread();
+        boolean wasActive = shell == mActiveShell;
+        if (wasActive) {
+            removeShell(shell);
+        } else {
+            if (shell.getParent() != null) {
+                shell.setContentViewRenderView(null);
+                removeView(shell);
+            }
+            mShells.remove(shell);
+        }
+        shell.close();
+        if (wasActive && !mShells.isEmpty()) selectShell(mShells.get(mShells.size() - 1));
+    }
+
