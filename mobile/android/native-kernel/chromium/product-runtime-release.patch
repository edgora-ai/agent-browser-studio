+// Global/static bridge: draining must still work after an Activity and its
+// ShellManager view have gone away. Callers must revoke navigation/input first,
+// await this callback with a bounded timeout, and only then close the engine.
+// True means Local Storage commit confirmed plus Cookie flush acknowledged for
+// every loaded persistent partition, not fsync or a fence for all storage APIs.
+static void JNI_ShellManager_FlushPersistentStorageForShutdown(
+    JNIEnv* env,
+    const JavaRef<jobject>& j_callback) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  auto complete = base::BindPostTaskToCurrentDefault(base::BindOnce(
+      [](base::android::ScopedJavaGlobalRef<jobject> callback, bool confirmed) {
+        base::android::RunBooleanCallbackAndroid(callback, confirmed);
+      },
+      base::android::ScopedJavaGlobalRef<jobject>(j_callback)));
+
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          kAgentBrowserProductProfileSwitch)) {
+    std::move(complete).Run(false);
+    return;
+  }
+  auto* client = ShellContentBrowserClient::Get();
+  auto* context = client && client->shell_browser_main_parts()
+                      ? client->browser_context()
+                      : nullptr;
+  if (!context || context->IsOffTheRecord() || context->ShutdownStarted()) {
+    std::move(complete).Run(false);
+    return;
+  }
+
+  // Best-effort quiesce only, not an all-writer fence: service workers and
+  // writes already in transit may outlive these page lifecycle notifications.
+  // Snapshot weak pointers before notifying observers, which may destroy tabs.
+  auto weak_context = context->GetWeakPtr();
+  std::vector<base::WeakPtr<WebContents>> pages;
+  for (auto* shell : Shell::windows()) {
+    auto* contents = shell->web_contents();
+    if (contents && contents->GetBrowserContext() == context &&
+        !contents->IsBeingDestroyed()) {
+      pages.push_back(contents->GetWeakPtr());
+    }
+  }
+  for (auto& contents : pages) {
+    if (!contents || contents->IsBeingDestroyed()) {
+      continue;
+    }
+    contents->Stop();
+    if (!contents || contents->IsBeingDestroyed()) {
+      continue;
+    }
+    contents->WasHidden();
+    if (contents && !contents->IsBeingDestroyed() &&
+        contents->GetVisibility() == Visibility::HIDDEN) {
+      contents->SetPageFrozen(true);
+    }
+  }
+  if (!weak_context || weak_context->ShutdownStarted()) {
+    std::move(complete).Run(false);
+    return;
+  }
+
+  // Do not instantiate unloaded partitions just to flush them, and never
+  // reinterpret off-the-record or memory-only storage as persistent evidence.
+  std::vector<StoragePartition*> partitions;
+  weak_context->ForEachLoadedStoragePartition([&](StoragePartition* partition) {
+    if (!partition->GetConfig().in_memory()) {
+      partitions.push_back(partition);
+    }
+  });
+  if (partitions.empty()) {
+    std::move(complete).Run(false);
+    return;
+  }
+
+  auto barrier = base::BarrierCallback<bool>(
+      2 * partitions.size(),
+      base::BindOnce(
+          [](base::OnceCallback<void(bool)> complete,
+             std::vector<bool> confirmations) {
+            std::move(complete).Run(std::all_of(
+                confirmations.begin(), confirmations.end(),
+                [](bool confirmed) { return confirmed; }));
+          },
+          std::move(complete)));
+  for (auto* partition : partitions) {
+    if (auto* dom_storage = partition->GetDOMStorageContext()) {
+      dom_storage->FlushLocalStorageForShutdown(
+          mojo::WrapCallbackWithDefaultInvokeIfNotRun(base::BindOnce(barrier),
+                                                    false));
+    } else {
+      barrier.Run(false);
+    }
+    if (auto* cookies = partition->GetCookieManagerForBrowserProcess()) {
+      // CookieManager has no disk-write error result. An invoked reply is only
+      // an acknowledgment; a dropped/disconnected reply is not confirmation.
+      cookies->FlushCookieStore(mojo::WrapCallbackWithDropHandler(
+          base::BindOnce(barrier, true), base::BindOnce(barrier, false)));
+    } else {
+      barrier.Run(false);
+    }
+  }
+}
+
 void DestroyShellManager() {
   JNIEnv* env = base::android::AttachCurrentThread();
   Java_ShellManager_destroy(env, g_global_state.Get().j_shell_manager);
