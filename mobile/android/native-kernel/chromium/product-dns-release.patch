+TEST(AgentBrowserProductDnsTest, InstallsDenyWithOnlyExactProxyBootstrap) {
+  base::test::ScopedCommandLine scoped_command;
+  const struct {
+    const char* endpoint;
+    const char* proxy_host;
+    const char* mapped_host;
+  } cases[] = {
+      {"http://192.168.4.100:20080", "192.168.4.100", "192.168.4.100"},
+      {"https://proxy.example:443", "proxy.example", "proxy.example"},
+      {"socks5://proxy.example:1080", "proxy.example", "proxy.example"},
+      {"http://[2001:db8::1]:8080", "[2001:db8::1]", "2001:db8::1"},
+  };
+  for (const auto& test : cases) {
+    SCOPED_TRACE(test.endpoint);
+    *scoped_command.GetProcessCommandLine() = ProxyCommand(test.endpoint);
+    auto params = network::mojom::NetworkContextParams::New();
+    ConfigureAgentBrowserProductNetworkContextParams(params.get());
+    ASSERT_TRUE(params->initial_proxy_config.has_value());
+    ASSERT_TRUE(params->agent_browser_local_dns_policy);
+    const auto& policy = params->agent_browser_local_dns_policy;
+    EXPECT_EQ(network::mojom::AgentBrowserLocalDnsMode::kProxyLocalDnsDeny,
+              policy->mode);
+    ASSERT_TRUE(policy->proxy_bootstrap_host.has_value());
+    EXPECT_EQ(test.proxy_host, *policy->proxy_bootstrap_host);
+    EXPECT_EQ(std::string("MAP * ^NOTFOUND, EXCLUDE localhost, EXCLUDE ") +
+                  "127.0.0.1, EXCLUDE " + test.mapped_host,
+              network::BuildAgentBrowserHostMappingRules(policy.get()));
+  }
+}
