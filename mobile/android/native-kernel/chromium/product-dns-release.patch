+  CHECK(!params->agent_browser_local_dns_policy);
+
+  // A fixed proxy only covers URL loads. DNS-only callers (including WebRTC
+  // STUN hostname resolution) still use this NetworkContext's HostResolver.
+  // Install the existing native deny policy at that resolver, before cache,
+  // hosts, system DNS and secure-DNS backends. HTTP CONNECT / SOCKS5 target
+  // hostnames continue to be sent to the sole proxy, not resolved locally.
+  const auto& chain = config.proxy_rules().single_proxies.First();
+  CHECK(chain.is_single_proxy());
+  CHECK(!chain.is_direct());
+  auto dns_policy = network::mojom::AgentBrowserLocalDnsPolicy::New();
+  dns_policy->mode =
+      network::mojom::AgentBrowserLocalDnsMode::kProxyLocalDnsDeny;
+  // Only the exact validated proxy host is a bootstrap exception. An IP-literal
+  // proxy requires no external bootstrap DNS. Hostname proxies intentionally
+  // retain that one exception; no origin hostname, wildcard or replacement IP
+  // comes from a command-line mapping rule. Validate in the browser as well as
+  // at the network-service consumer, so unsupported input fails closed early.
+  dns_policy->proxy_bootstrap_host = chain.First().GetHost();
+  CHECK(!network::BuildAgentBrowserHostMappingRules(dns_policy.get()).empty());
+  params->agent_browser_local_dns_policy = std::move(dns_policy);
+
   params->initial_proxy_config =
