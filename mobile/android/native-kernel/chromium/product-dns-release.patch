+TEST(AgentBrowserProductDnsTest, DnsOnlyTargetsNeverReachTheResolverBackend) {
+  base::test::TaskEnvironment task_environment;
+  base::test::ScopedCommandLine scoped_command;
+  *scoped_command.GetProcessCommandLine() = ProxyCommand("http://proxy.example:80");
+  auto params = network::mojom::NetworkContextParams::New();
+  ConfigureAgentBrowserProductNetworkContextParams(params.get());
+  ASSERT_TRUE(params->agent_browser_local_dns_policy);
+  auto inner = std::make_unique<net::MockHostResolver>();
+  auto state = inner->state();
+  inner->set_synchronous_mode(true);
+  // A synthetic test backend is never reached for denied targets. This does
+  // not install answers in a product browser or influence a website result.
+  inner->rules()->AddRule("*", "192.0.2.42");
+  net::MappedHostResolver resolver(std::move(inner));
+  resolver.SetRulesFromString(network::BuildAgentBrowserHostMappingRules(
+      params->agent_browser_local_dns_policy.get()));
+  for (auto source : {net::HostResolverSource::ANY,
+                      net::HostResolverSource::SYSTEM}) {
+    for (const char* host : {"r-fresh.d.ping0.cc", "target.example", "target.local",
+                             "sub.proxy.example", "proxy.example.evil"}) {
+      SCOPED_TRACE(host);
+      net::HostResolver::ResolveHostParameters parameters;
+      parameters.source = source;
+      parameters.secure_dns_policy = net::SecureDnsPolicy::kDisable;
+      auto request = resolver.CreateRequest(
+          net::HostPortPair(host, 3478), net::NetworkAnonymizationKey(),
+          net::handles::kInvalidNetworkHandle, net::NetLogWithSource(), parameters);
+      net::TestCompletionCallback result;
+      EXPECT_EQ(net::ERR_NAME_NOT_RESOLVED, request->Start(result.callback()));
+    }
+  }
+  EXPECT_EQ(0u, state->num_resolve());
+  auto bootstrap = resolver.CreateRequest(
+      net::HostPortPair("proxy.example", 80), net::NetworkAnonymizationKey(),
+      net::handles::kInvalidNetworkHandle, net::NetLogWithSource(), std::nullopt);
+  net::TestCompletionCallback result;
+  EXPECT_EQ(net::OK, bootstrap->Start(result.callback()));
+  EXPECT_EQ(1u, state->num_resolve());
+}
