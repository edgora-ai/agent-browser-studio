+TEST_P(AndroidFrameSinkManagerTest,
+       PreservesRootSupportAndPendingProviderAcrossRepeatedThreeTabReattach) {
+  if (!ExpectedInputManagerCreation()) {
+    GTEST_SKIP() << "Requires supported, enabled InputOnViz";
+  }
+
+  RootCompositorFrameSinkData root_data;
+  manager_->CreateRootCompositorFrameSink(
+      root_data.BuildParams(kFrameSinkIdRoot));
+  ASSERT_TRUE(CompositorFrameSinkExists(kFrameSinkIdRoot));
+
+  auto* input_manager = GetMockInputManager();
+  ASSERT_TRUE(input_manager);
+
+  struct RootSupportState {
+    FrameSinkId frame_sink_id;
+    base::WeakPtr<RenderInputRouterSupportAndroid> support;
+    base::WeakPtr<input::RenderWidgetHostViewInput> input_view;
+    scoped_refptr<ui::FilteredGestureProvider> provider;
+    raw_ptr<input::RenderInputRouter> rir = nullptr;
+    raw_ptr<const ui::MotionEvent> current_down = nullptr;
+    uint32_t pending_down_id = 0;
+  };
+  std::array<RootSupportState, 3> tabs;
+  tabs[0].frame_sink_id = kFrameSinkIdA;
+  tabs[1].frame_sink_id = kFrameSinkIdB;
+  tabs[2].frame_sink_id = kFrameSinkIdC;
+
+  for (auto& tab : tabs) {
+    SCOPED_TRACE(tab.frame_sink_id.ToString());
+    manager_->RegisterFrameSinkId(tab.frame_sink_id,
+                                  true /* report_activation */);
+    // Separate pages/tabs have independent page input routers.
+    CreateCompositorFrameSink(
+        tab.frame_sink_id,
+        CreateRIRConfig(base::UnguessableToken::Create()));
+    manager_->RegisterFrameSinkHierarchy(kFrameSinkIdRoot, tab.frame_sink_id);
+    ASSERT_FALSE(IsRenderInputRouterSupportChildFrame(tab.frame_sink_id));
+    auto* support = static_cast<RenderInputRouterSupportAndroid*>(
+        input_manager->GetSupportForFrameSink(tab.frame_sink_id));
+    ASSERT_TRUE(support);
+    tab.support = support->GetWeakPtr();
+    tab.input_view = support->GetInputWeakPtr();
+    tab.provider = support->GetGestureProvider();
+    tab.rir = input_manager->GetRenderInputRouterForId(tab.frame_sink_id);
+    ASSERT_TRUE(tab.provider);
+    ASSERT_TRUE(tab.rir);
+    ASSERT_EQ(tab.rir, support->GetViewRenderInputRouter());
+
+    // Seed only the real provider's pending unacknowledged-touch state. Do not
+    // route an invented WebTouch through a fake renderer or claim RIR acceptance.
+    ui::PointerProperties pointer(10.f, 20.f, 8.f);
+    pointer.tool_type = ui::MotionEvent::ToolType::FINGER;
+    pointer.pressure = 1.f;
+    ui::MotionEventGeneric down(ui::MotionEvent::Action::DOWN,
+                                base::TimeTicks::Now(), pointer);
+    ASSERT_TRUE(tab.provider->OnTouchEvent(down).succeeded);
+    // Intentionally do not call OnTouchEventAck().
+    tab.current_down = tab.provider->GetCurrentDownEvent();
+    tab.pending_down_id = down.GetUniqueEventId();
+    ASSERT_TRUE(tab.current_down);
+    EXPECT_EQ(tab.pending_down_id, tab.current_down->GetUniqueEventId());
+
+    manager_->UnregisterFrameSinkHierarchy(kFrameSinkIdRoot,
+                                            tab.frame_sink_id);
+    EXPECT_EQ(0, manager_->GetNumParents(tab.frame_sink_id));
+    ASSERT_TRUE(tab.support);
+    ASSERT_TRUE(tab.input_view);
+    EXPECT_EQ(tab.current_down, tab.provider->GetCurrentDownEvent());
+  }
+
+  // Like a persistent tab host, only one tab is attached at a time. Every visit
+  // traverses 0 -> 1 parents, not the distinct multiple-parent transition path.
+  for (int round = 0; round < 30; ++round) {
+    SCOPED_TRACE(round);
+    for (auto& tab : tabs) {
+      SCOPED_TRACE(tab.frame_sink_id.ToString());
+      EXPECT_EQ(0, manager_->GetNumParents(tab.frame_sink_id));
+      manager_->RegisterFrameSinkHierarchy(kFrameSinkIdRoot, tab.frame_sink_id);
+      EXPECT_EQ(1, manager_->GetNumParents(tab.frame_sink_id));
+
+      // Weak pointers, unlike raw address equality, cannot falsely survive an
+      // old support's deletion followed by allocator reuse at the same address.
+      ASSERT_TRUE(tab.support);
+      ASSERT_TRUE(tab.input_view);
+      ASSERT_EQ(tab.support.get(),
+                input_manager->GetSupportForFrameSink(tab.frame_sink_id));
+      EXPECT_EQ(tab.support.get(), tab.input_view.get());
+      EXPECT_FALSE(tab.support->IsRenderInputRouterSupportChildFrame());
+      EXPECT_EQ(tab.provider.get(),
+                tab.support->GetGestureProvider().get());
+      EXPECT_EQ(tab.rir,
+                input_manager->GetRenderInputRouterForId(tab.frame_sink_id));
+      EXPECT_EQ(tab.rir, tab.support->GetViewRenderInputRouter());
+      EXPECT_EQ(kFrameSinkIdRoot, tab.support->GetRootFrameSinkId());
+      ASSERT_EQ(tab.current_down,
+                tab.support->GetGestureProvider()->GetCurrentDownEvent());
+      EXPECT_EQ(tab.pending_down_id, tab.current_down->GetUniqueEventId());
+      EXPECT_EQ(ui::MotionEvent::Action::DOWN, tab.current_down->GetAction());
+
+      manager_->UnregisterFrameSinkHierarchy(kFrameSinkIdRoot,
+                                              tab.frame_sink_id);
+      EXPECT_EQ(0, manager_->GetNumParents(tab.frame_sink_id));
+      ASSERT_TRUE(tab.support);
+      ASSERT_TRUE(tab.input_view);
+      EXPECT_EQ(tab.provider.get(),
+                tab.support->GetGestureProvider().get());
+      EXPECT_EQ(tab.current_down,
+                tab.support->GetGestureProvider()->GetCurrentDownEvent());
+    }
+  }
+
+  // Release external provider refs while their support-owned reference is
+  // still alive. Support destruction will Shutdown() and destroy the provider,
+  // cancelling its timers rather than retaining a provider with a dead client.
+  for (auto& tab : tabs) {
+    tab.current_down = nullptr;
+    tab.rir = nullptr;
+    tab.provider.reset();
+    manager_->InvalidateFrameSinkId(tab.frame_sink_id, {});
+    EXPECT_FALSE(tab.support);
+    EXPECT_FALSE(tab.input_view);
+  }
+  manager_->InvalidateFrameSinkId(kFrameSinkIdRoot, {});
+}
+
+TEST_P(AndroidFrameSinkManagerTest,
+       PreservesRootSupportWhenOldRootIsDestroyedAndNewRootCreated) {
+  if (!ExpectedInputManagerCreation()) {
+    GTEST_SKIP() << "Requires supported, enabled InputOnViz";
+  }
+
+  RootCompositorFrameSinkData old_root_data;
+  manager_->CreateRootCompositorFrameSink(
+      old_root_data.BuildParams(kFrameSinkIdRoot));
+  manager_->RegisterFrameSinkId(kFrameSinkIdA, true /* report_activation */);
+  CreateCompositorFrameSink(
+      kFrameSinkIdA, CreateRIRConfig(base::UnguessableToken::Create()));
+  manager_->RegisterFrameSinkHierarchy(kFrameSinkIdRoot, kFrameSinkIdA);
+  ASSERT_FALSE(IsRenderInputRouterSupportChildFrame(kFrameSinkIdA));
+
+  auto* input_manager = GetMockInputManager();
+  auto* support = static_cast<RenderInputRouterSupportAndroid*>(
+      input_manager->GetSupportForFrameSink(kFrameSinkIdA));
+  auto support_weak = support->GetWeakPtr();
+  auto input_weak = support->GetInputWeakPtr();
+  auto provider = support->GetGestureProvider();
+  auto* rir = input_manager->GetRenderInputRouterForId(kFrameSinkIdA);
+  EXPECT_EQ(kFrameSinkIdRoot, support->GetRootFrameSinkId());
+
+  manager_->UnregisterFrameSinkHierarchy(kFrameSinkIdRoot, kFrameSinkIdA);
+  EXPECT_EQ(0, manager_->GetNumParents(kFrameSinkIdA));
+  manager_->InvalidateFrameSinkId(kFrameSinkIdRoot, {});
+  EXPECT_FALSE(CompositorFrameSinkExists(kFrameSinkIdRoot));
+  ASSERT_TRUE(support_weak);
+  ASSERT_TRUE(input_weak);
+
+  RootCompositorFrameSinkData new_root_data;
+  manager_->CreateRootCompositorFrameSink(
+      new_root_data.BuildParams(kFrameSinkIdRoot2));
+  ASSERT_TRUE(CompositorFrameSinkExists(kFrameSinkIdRoot2));
+  ASSERT_TRUE(support_weak);
+  manager_->RegisterFrameSinkHierarchy(kFrameSinkIdRoot2, kFrameSinkIdA);
+
+  ASSERT_TRUE(support_weak);
+  ASSERT_TRUE(input_weak);
+  EXPECT_EQ(support_weak.get(),
+            input_manager->GetSupportForFrameSink(kFrameSinkIdA));
+  EXPECT_EQ(provider.get(), support_weak->GetGestureProvider().get());
+  EXPECT_EQ(rir, input_manager->GetRenderInputRouterForId(kFrameSinkIdA));
+  EXPECT_EQ(rir, support_weak->GetViewRenderInputRouter());
+  // Reuse must not retain a cached reference to the old compositor root.
+  EXPECT_EQ(kFrameSinkIdRoot2, support_weak->GetRootFrameSinkId());
+
+  provider.reset();
+  manager_->UnregisterFrameSinkHierarchy(kFrameSinkIdRoot2, kFrameSinkIdA);
+  manager_->InvalidateFrameSinkId(kFrameSinkIdA, {});
+  manager_->InvalidateFrameSinkId(kFrameSinkIdRoot2, {});
+}
