+TEST_P(AndroidFrameSinkManagerTest,
+       ReconstructsSupportOnActualRootChildRootTransitions) {
+  if (!ExpectedInputManagerCreation()) {
+    GTEST_SKIP() << "Requires supported, enabled InputOnViz";
+  }
+
+  RootCompositorFrameSinkData root_data;
+  manager_->CreateRootCompositorFrameSink(
+      root_data.BuildParams(kFrameSinkIdRoot));
+  const auto grouping_id = base::UnguessableToken::Create();
+  manager_->RegisterFrameSinkId(kFrameSinkIdA, true /* report_activation */);
+  manager_->RegisterFrameSinkId(kFrameSinkIdB, true /* report_activation */);
+  CreateCompositorFrameSink(kFrameSinkIdA, CreateRIRConfig(grouping_id));
+  CreateCompositorFrameSink(kFrameSinkIdB, CreateRIRConfig(grouping_id));
+  manager_->RegisterFrameSinkHierarchy(kFrameSinkIdRoot, kFrameSinkIdA);
+  manager_->RegisterFrameSinkHierarchy(kFrameSinkIdRoot, kFrameSinkIdB);
+  ASSERT_FALSE(IsRenderInputRouterSupportChildFrame(kFrameSinkIdA));
+
+  auto* input_manager = GetMockInputManager();
+  auto* root_support = static_cast<RenderInputRouterSupportAndroid*>(
+      input_manager->GetSupportForFrameSink(kFrameSinkIdA));
+  auto old_root_weak = root_support->GetWeakPtr();
+  auto old_root_input_weak = root_support->GetInputWeakPtr();
+  auto old_provider = root_support->GetGestureProvider();
+  auto* rir = input_manager->GetRenderInputRouterForId(kFrameSinkIdA);
+
+  // root -> A and root -> B -> A: two parents defer kind reconstruction.
+  manager_->RegisterFrameSinkHierarchy(kFrameSinkIdB, kFrameSinkIdA);
+  EXPECT_EQ(2, manager_->GetNumParents(kFrameSinkIdA));
+  ASSERT_TRUE(old_root_weak);
+  manager_->UnregisterFrameSinkHierarchy(kFrameSinkIdRoot, kFrameSinkIdA);
+  ASSERT_TRUE(IsRenderInputRouterSupportChildFrame(kFrameSinkIdA));
+  EXPECT_FALSE(old_root_weak);
+  EXPECT_FALSE(old_root_input_weak);
+  EXPECT_EQ(rir, input_manager->GetRenderInputRouterForId(kFrameSinkIdA));
+  auto* child_support = input_manager->GetSupportForFrameSink(kFrameSinkIdA);
+  ASSERT_TRUE(child_support);
+  auto child_weak = child_support->GetInputWeakPtr();
+  EXPECT_EQ(rir, child_support->GetViewRenderInputRouter());
+
+  // Adding a direct root parent still defers until B -> A is removed.
+  manager_->RegisterFrameSinkHierarchy(kFrameSinkIdRoot, kFrameSinkIdA);
+  EXPECT_EQ(2, manager_->GetNumParents(kFrameSinkIdA));
+  ASSERT_TRUE(child_weak);
+  manager_->UnregisterFrameSinkHierarchy(kFrameSinkIdB, kFrameSinkIdA);
+  ASSERT_FALSE(IsRenderInputRouterSupportChildFrame(kFrameSinkIdA));
+  EXPECT_FALSE(child_weak);
+  EXPECT_EQ(rir, input_manager->GetRenderInputRouterForId(kFrameSinkIdA));
+  auto* new_root_support = static_cast<RenderInputRouterSupportAndroid*>(
+      input_manager->GetSupportForFrameSink(kFrameSinkIdA));
+  auto new_root_weak = new_root_support->GetWeakPtr();
+  auto new_provider = new_root_support->GetGestureProvider();
+  // old_provider remains refcounted here, so provider address reuse cannot make
+  // this inequality accidentally fail after a valid kind transition.
+  EXPECT_NE(old_provider.get(), new_provider.get());
+  EXPECT_EQ(rir, new_root_support->GetViewRenderInputRouter());
+  EXPECT_EQ(kFrameSinkIdRoot, new_root_support->GetRootFrameSinkId());
+
+  // After promotion, another same-kind detach/reattach must preserve this new
+  // Android support, not resurrect the original one or reconstruct again.
+  manager_->UnregisterFrameSinkHierarchy(kFrameSinkIdRoot, kFrameSinkIdA);
+  manager_->RegisterFrameSinkHierarchy(kFrameSinkIdRoot, kFrameSinkIdA);
+  ASSERT_TRUE(new_root_weak);
+  EXPECT_EQ(new_root_weak.get(),
+            input_manager->GetSupportForFrameSink(kFrameSinkIdA));
+  EXPECT_EQ(new_provider.get(), new_root_weak->GetGestureProvider().get());
+
+  old_provider.reset();
+  new_provider.reset();
+  manager_->UnregisterFrameSinkHierarchy(kFrameSinkIdRoot, kFrameSinkIdA);
+  manager_->UnregisterFrameSinkHierarchy(kFrameSinkIdRoot, kFrameSinkIdB);
+  manager_->InvalidateFrameSinkId(kFrameSinkIdA, {});
+  manager_->InvalidateFrameSinkId(kFrameSinkIdB, {});
+  manager_->InvalidateFrameSinkId(kFrameSinkIdRoot, {});
+}
+
+TEST_P(AndroidFrameSinkManagerTest,
+       StillReconstructsChildSupportOnChildToChildReparent) {
+  if (!ExpectedInputManagerCreation()) {
+    GTEST_SKIP() << "Requires supported, enabled InputOnViz";
+  }
+
+  RootCompositorFrameSinkData root_data;
+  manager_->CreateRootCompositorFrameSink(
+      root_data.BuildParams(kFrameSinkIdRoot));
+  const auto grouping_id = base::UnguessableToken::Create();
+  for (const auto& id : {kFrameSinkIdA, kFrameSinkIdB, kFrameSinkIdC}) {
+    manager_->RegisterFrameSinkId(id, true /* report_activation */);
+    CreateCompositorFrameSink(id, CreateRIRConfig(grouping_id));
+  }
+  manager_->RegisterFrameSinkHierarchy(kFrameSinkIdRoot, kFrameSinkIdB);
+  manager_->RegisterFrameSinkHierarchy(kFrameSinkIdRoot, kFrameSinkIdC);
+  manager_->RegisterFrameSinkHierarchy(kFrameSinkIdB, kFrameSinkIdA);
+  ASSERT_TRUE(IsRenderInputRouterSupportChildFrame(kFrameSinkIdA));
+
+  auto* input_manager = GetMockInputManager();
+  auto* child_support = input_manager->GetSupportForFrameSink(kFrameSinkIdA);
+  auto old_child_weak = child_support->GetInputWeakPtr();
+  auto* rir = input_manager->GetRenderInputRouterForId(kFrameSinkIdA);
+  manager_->RegisterFrameSinkHierarchy(kFrameSinkIdC, kFrameSinkIdA);
+  EXPECT_EQ(2, manager_->GetNumParents(kFrameSinkIdA));
+  ASSERT_TRUE(old_child_weak);
+  manager_->UnregisterFrameSinkHierarchy(kFrameSinkIdB, kFrameSinkIdA);
+
+  // Deliberately keep the preexisting child->child reconstruction semantics.
+  // Its screen-stability/bubbling caches require a separate reuse design.
+  EXPECT_FALSE(old_child_weak);
+  ASSERT_TRUE(IsRenderInputRouterSupportChildFrame(kFrameSinkIdA));
+  EXPECT_EQ(rir, input_manager->GetRenderInputRouterForId(kFrameSinkIdA));
+  EXPECT_EQ(input_manager->GetSupportForFrameSink(kFrameSinkIdC),
+            input_manager->GetParentRenderInputRouterSupport(kFrameSinkIdA));
+
+  manager_->UnregisterFrameSinkHierarchy(kFrameSinkIdC, kFrameSinkIdA);
+  manager_->UnregisterFrameSinkHierarchy(kFrameSinkIdRoot, kFrameSinkIdB);
+  manager_->UnregisterFrameSinkHierarchy(kFrameSinkIdRoot, kFrameSinkIdC);
+  manager_->InvalidateFrameSinkId(kFrameSinkIdA, {});
+  manager_->InvalidateFrameSinkId(kFrameSinkIdB, {});
+  manager_->InvalidateFrameSinkId(kFrameSinkIdC, {});
+  manager_->InvalidateFrameSinkId(kFrameSinkIdRoot, {});
+}
