<?xml version="1.0" encoding="utf-8"?>
<!-- Night twin of AppTheme. Window/bar colors follow the dark canvas so the system bars and
     launch flash match Ui's dark palette; accent and control colors are resolved in code. -->
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#F3F3F3</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#141414</item>
        <item name="android:navigationBarColor">#141414</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">#141414</item>
    </style>
</resources>
