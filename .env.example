# Agent Browser Studio local development environment example.
# Copy to .env if you need local overrides. Do not commit .env.

# Enable the real LLM E2E test suite explicitly.
# REAL_LLM=1
# REAL_LLM_API_KEY=replace-with-your-local-test-key
# REAL_LLM_API_URL=https://api.openai.com/v1/chat/completions
# REAL_LLM_MODEL=gpt-4o-mini

# Optional managed Chromium overrides.
# AGENT_BROWSER_CHROMIUM_BINARY_PATH=/absolute/path/to/Chromium
# AGENT_BROWSER_CHROMIUM_CACHE_DIR=/absolute/path/to/managed-cache

# Credential backend override. The default is OS storage for a team-signed
# build and a mode-0600 local AES-GCM vault for macOS development/ad-hoc apps.
# AGENT_BROWSER_SECRET_BACKEND=file

# Optional loopback MCP overrides. Generate a private random token locally.
# AGENT_BROWSER_MCP_PORT=26581
# AGENT_BROWSER_MCP_TOKEN=replace-with-a-random-local-token

# Optional native MASQUE helper override.
# AGENT_BROWSER_MASQUE_BRIDGE_PATH=/absolute/path/to/agent-browser-masque-bridge

# Optional Electron / debugging flags can be added locally as needed.
# ELECTRON_ENABLE_LOGGING=1
