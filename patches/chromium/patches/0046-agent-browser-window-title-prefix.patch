diff --git a/chrome/common/chrome_switches.cc b/chrome/common/chrome_switches.cc
index 8fe7e1f..6935bb6 100644
--- a/chrome/common/chrome_switches.cc
+++ b/chrome/common/chrome_switches.cc
@@ -32,6 +32,12 @@ const char kAcceptLang[] = "accept-lang";
 const char kAgentBrowserSuppressMissingGoogleApiKeyInfoBar[] =
     "agent-browser-suppress-missing-google-api-key-infobar";
 
+// Agent Browser: optional window-title prefix shown in the window frame and
+// taskbar label (e.g. the profile name). It is applied only to the native
+// window title; document.title and page-visible surfaces are unaffected.
+const char kAgentBrowserWindowTitlePrefix[] =
+    "agent-browser-window-title-prefix";
+
 #if BUILDFLAG(IS_MAC)
 // Only if we're running in an unsigned build, passing this flag will allow
 // app shims whose code signature does not match what chrome is expecting to
diff --git a/chrome/common/chrome_switches.h b/chrome/common/chrome_switches.h
index 1074e18..7451c50 100644
--- a/chrome/common/chrome_switches.h
+++ b/chrome/common/chrome_switches.h
@@ -38,6 +38,7 @@ namespace switches {
 // alongside the definition of their values in the .cc file.
 extern const char kAcceptLang[];
 extern const char kAgentBrowserSuppressMissingGoogleApiKeyInfoBar[];
+extern const char kAgentBrowserWindowTitlePrefix[];
 #if BUILDFLAG(IS_MAC)
 extern const char kAllowAppShimSignatureMismatchForTests[];
 #endif
diff --git a/chrome/browser/ui/views/frame/browser_view.cc b/chrome/browser/ui/views/frame/browser_view.cc
--- a/chrome/browser/ui/views/frame/browser_view.cc
+++ b/chrome/browser/ui/views/frame/browser_view.cc
@@ -33,7 +33,8 @@
 #include "base/notreached.h"
 #include "base/scoped_observation.h"
 #include "base/strings/string_number_conversions.h"
 #include "base/strings/stringprintf.h"
+#include "base/strings/utf_string_conversions.h"
 #include "base/task/sequenced_task_runner.h"
 #include "base/task/single_thread_task_runner.h"
 #include "base/trace_event/trace_event.h"
@@ -3568,19 +3569,29 @@ std::u16string BrowserView::GetWindowTitle() const {
 std::u16string BrowserView::GetWindowTitle() const {
   std::u16string title =
       WindowMetadataController::From(browser_.get())
           ->GetWindowTitleForCurrentTab(true /* include_app_name */);
+  // Agent Browser: optional window-title prefix shown in the window frame and
+  // taskbar label (e.g. the profile name). It is applied only to the native
+  // window title; document.title and page-visible surfaces are unaffected.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          switches::kAgentBrowserWindowTitlePrefix)) {
+    title = base::UTF8ToUTF16(base::CommandLine::ForCurrentProcess()
+                                 ->GetSwitchValueASCII(
+                                     switches::kAgentBrowserWindowTitlePrefix)) +
+            u" " + title;
+  }
 #if BUILDFLAG(IS_MAC)
   bool any_tab_playing_audio = false;
   bool any_tab_playing_muted_audio = false;
   GetAnyTabAudioStates(browser_.get(), &any_tab_playing_audio,
                        &any_tab_playing_muted_audio);
   if (any_tab_playing_audio) {
     title = l10n_util::GetStringFUTF16(IDS_WINDOW_AUDIO_PLAYING_MAC, title,
                                        u"\U0001F50A");
   } else if (any_tab_playing_muted_audio) {
     title = l10n_util::GetStringFUTF16(IDS_WINDOW_AUDIO_MUTING_MAC, title,
                                        u"\U0001F507");
   }
 #endif
   return title;
 }
