+namespace {
+
+// Agent Browser: optional OS-level window-title prefix (taskbar label).
+// --agent-browser-window-title-prefix=<text> affects only the window frame and
+// the taskbar label; document.title and every page-visible surface stay
+// untouched, so the fingerprint surface is not affected.
+std::u16string MaybeAppendWindowTitlePrefix(std::u16string title) {
+  const std::string prefix =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          switches::kAgentBrowserWindowTitlePrefix);
+  if (prefix.empty() || title.empty()) {
+    return title;
+  }
+  return base::UTF8ToUTF16(prefix) + u" \u2014 " + title;
+}
+
+}  // namespace
