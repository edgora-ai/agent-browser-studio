   }
+#elif BUILDFLAG(IS_MAC) || BUILDFLAG(IS_WIN)
+  // Agent Browser: register a managed Widevine CDM supplied through
+  // --widevine-cdm-path. Stock Chromium registers no Widevine CDM on
+  // macOS/Windows (Google Chrome does it through the component updater at
+  // runtime), so the managed CDM staged by the app is registered here instead.
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  if (!command_line.HasSwitch(kWidevineCdmPathSwitch)) {
+    DVLOG(1) << "Widevine CDM path switch not set; not registering";
+    return;
+  }
+  std::unique_ptr<content::CdmInfo> info = CreateCdmInfoFromWidevineDirectory(
+      command_line.GetSwitchValuePath(kWidevineCdmPathSwitch));
+  if (info) {
+    VLOG(1) << "Registering Widevine CDM " << info->capability->version
+            << " from " << info->path;
+    cdms->push_back(*info);
+  }
 #endif  // BUILDFLAG(IS_ANDROID)
 }
 
