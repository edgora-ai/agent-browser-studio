+int RoxyMediaDeviceCount(const RoxyFingerprintConfig& config,
+                         mojom::blink::MediaDeviceType type) {
+  switch (type) {
+    case mojom::blink::MediaDeviceType::kMediaAudioInput:
+      return config.media_audio_inputs();
+    case mojom::blink::MediaDeviceType::kMediaVideoInput:
+      return config.media_video_inputs();
+    case mojom::blink::MediaDeviceType::kMediaAudioOutput:
+      return config.media_audio_outputs();
+    case mojom::blink::MediaDeviceType::kNumMediaDeviceTypes:
+      return 0;
+  }
+  NOTREACHED();
+}
+
+String RoxyMediaDeviceLabel(const RoxyFingerprintConfig& config,
+                            mojom::blink::MediaDeviceType type) {
+  const bool is_macos = config.platform() == "MacIntel";
+  switch (type) {
+    case mojom::blink::MediaDeviceType::kMediaAudioInput:
+      return is_macos ? "MacBook Microphone"
+                      : "Microphone (Realtek(R) Audio)";
+    case mojom::blink::MediaDeviceType::kMediaVideoInput:
+      return is_macos ? "FaceTime HD Camera" : "Integrated Camera";
+    case mojom::blink::MediaDeviceType::kMediaAudioOutput:
+      return is_macos ? "MacBook Speakers"
+                      : "Speakers (Realtek(R) Audio)";
+    case mojom::blink::MediaDeviceType::kNumMediaDeviceTypes:
+      return String();
+  }
+  NOTREACHED();
+}
