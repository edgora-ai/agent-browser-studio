+  if (roxy_config.enabled() && roxy_config.media_devices_enabled()) {
+    bool reveal_labels = false;
+    for (const auto& devices_by_type : enumeration) {
+      for (const WebMediaDeviceInfo& device : devices_by_type)
+        reveal_labels |= !device.label.empty();
+    }
+    ExecutionContext* context = ExecutionContext::From(script_state);
+    const std::string origin =
+        context->GetSecurityOrigin()->ToString().Utf8().c_str();
+    for (wtf_size_t i = 0;
+         i < static_cast<wtf_size_t>(
+                 mojom::blink::MediaDeviceType::kNumMediaDeviceTypes);
+         ++i) {
+      const auto device_type = static_cast<mojom::blink::MediaDeviceType>(i);
+      const int count = RoxyMediaDeviceCount(roxy_config, device_type);
+      for (int j = 0; j < count; ++j) {
+        const std::string device_scope = base::StringPrintf(
+            "%s:%d:%d", origin.c_str(), static_cast<int>(device_type), j);
+        const std::string group_scope = base::StringPrintf(
+            "%s:%s:%d", origin.c_str(),
+            device_type == mojom::blink::MediaDeviceType::kMediaVideoInput
+                ? "video"
+                : "audio",
+            j);
+        const String device_id = String::FromUtf8(
+            roxy_config.StableToken("media-device", device_scope));
+        const String group_id = String::FromUtf8(
+            roxy_config.StableToken("media-group", group_scope));
+        const String label = reveal_labels
+                                 ? RoxyMediaDeviceLabel(roxy_config, device_type)
+                                 : String();
+        if (device_type == mojom::blink::MediaDeviceType::kMediaAudioInput ||
+            device_type == mojom::blink::MediaDeviceType::kMediaVideoInput) {
+          media_devices.push_back(MakeGarbageCollected<InputDeviceInfo>(
+              device_id, label, group_id, device_type));
+          result_contains_nonempty_input_device_ids = true;
+        } else {
+          media_devices.push_back(MakeGarbageCollected<MediaDeviceInfo>(
+              device_id, label, group_id, device_type));
+        }
+      }
+    }
+    ReportCompletedEnumerateDevices(result_contains_nonempty_input_device_ids);
+    result_tracker->Resolve(media_devices);
+    tracer->End();
+    return;
+  }
   for (wtf_size_t i = 0;
        i < static_cast<wtf_size_t>(
                mojom::blink::MediaDeviceType::kNumMediaDeviceTypes);
