@@ -311,12 +345,15 @@ void AudioBuffer::copyToChannel(
   DCHECK(dst.data());
 
   dst.subspan(buffer_offset, count).copy_from(src.first(count));
+  roxy_noised_channels_[channel_number] = 0;
 }
 
 void AudioBuffer::Zero() {
   for (unsigned i = 0; i < channels_.size(); ++i) {
-    if (NotShared<DOMFloat32Array> array = getChannelData(i)) {
+    NotShared<DOMFloat32Array> array(channels_[i].Get());
+    if (array) {
       std::ranges::fill(array->AsSpan(), 0.0f);
+      roxy_noised_channels_[i] = 0;
     }
   }
 }
