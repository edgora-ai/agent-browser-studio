@@ -224,6 +236,27 @@ NotShared<DOMFloat32Array> AudioBuffer::getChannelData(unsigned channel_index) {
   return NotShared<DOMFloat32Array>(channels_[channel_index].Get());
 }
 
+void AudioBuffer::ApplyRoxyFingerprintNoise(unsigned channel_index) {
+  const RoxyFingerprintConfig& config = RoxyFingerprintConfig::Get();
+  if (!config.enabled() || !config.audio_noise_enabled() ||
+      config.audio_noise_amplitude() <= 0 ||
+      channel_index >= channels_.size() ||
+      roxy_noised_channels_[channel_index]) {
+    return;
+  }
+
+  base::span<float> samples = channels_[channel_index].Get()->AsSpan();
+  uint64_t state = config.audio_noise_seed() ^
+                   (static_cast<uint64_t>(channel_index) << 32);
+  const double amplitude = config.audio_noise_amplitude();
+  for (size_t index = 0; index < samples.size(); ++index) {
+    state = MixAudioNoise(state ^ index);
+    const double unit = static_cast<double>(state & 0xffff) / 65535.0;
+    samples[index] += static_cast<float>((unit * 2.0 - 1.0) * amplitude);
+  }
+  roxy_noised_channels_[channel_index] = 1;
+}
+
