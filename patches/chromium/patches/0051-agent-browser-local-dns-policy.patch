+TEST(AgentBrowserLocalDnsPolicyTest,
+     ResolverDeniesBeforeFallbackWithExactExceptions) {
+  base::test::TaskEnvironment task_environment;
+  auto inner = std::make_unique<net::MockHostResolver>();
+  auto state = inner->state();
+  inner->set_synchronous_mode(true);
+  inner->rules()->AddRule("*", "192.0.2.42");
+  net::MappedHostResolver resolver(std::move(inner));
+  auto policy = mojom::AgentBrowserLocalDnsPolicy::New();
+  policy->proxy_bootstrap_host = "proxy.example";
+  resolver.SetRulesFromString(BuildAgentBrowserHostMappingRules(policy.get()));
+
+  // Includes SYSTEM / disabled secure DNS: deny precedes the resolver backend,
+  // so neither cache nor a failed proxy selection can open local DNS.
+  for (const char* host :
+       {"target.example", "sub.proxy.example", "proxy.example.evil",
+        "sub.localhost", "localhost.evil", "127.0.0.2", "::1"}) {
+    SCOPED_TRACE(host);
+    net::HostResolver::ResolveHostParameters parameters;
+    parameters.source = net::HostResolverSource::SYSTEM;
+    parameters.secure_dns_policy = net::SecureDnsPolicy::kDisable;
+    auto request = resolver.CreateRequest(
+        net::HostPortPair(host, 443), net::NetworkAnonymizationKey(),
+        net::handles::kInvalidNetworkHandle, net::NetLogWithSource(),
+        parameters);
+    net::TestCompletionCallback callback;
+    EXPECT_EQ(net::ERR_NAME_NOT_RESOLVED, request->Start(callback.callback()));
+  }
+  auto scheme_request = resolver.CreateRequest(
+      url::SchemeHostPort(GURL("https://target.example/")),
+      net::NetworkAnonymizationKey(), net::handles::kInvalidNetworkHandle,
+      net::NetLogWithSource(), std::nullopt);
+  net::TestCompletionCallback callback;
+  EXPECT_EQ(net::ERR_NAME_NOT_RESOLVED,
+            scheme_request->Start(callback.callback()));
+  auto endpoint_request = resolver.CreateServiceEndpointRequest(
+      net::HostResolver::Host(
+          url::SchemeHostPort(GURL("https://target.example/"))),
+      net::NetworkAnonymizationKey(), net::handles::kInvalidNetworkHandle,
+      net::NetLogWithSource(), net::HostResolver::ResolveHostParameters());
+  EXPECT_EQ(net::ERR_NAME_NOT_RESOLVED, endpoint_request->Start(nullptr));
+  EXPECT_EQ(0u, state->num_resolve());
+  for (const char* host : {"localhost", "127.0.0.1", "proxy.example"}) {
+    auto request = resolver.CreateRequest(
+        net::HostPortPair(host, 443), net::NetworkAnonymizationKey(),
+        net::handles::kInvalidNetworkHandle, net::NetLogWithSource(),
+        std::nullopt);
+    net::TestCompletionCallback result;
+    EXPECT_EQ(net::OK, request->Start(result.callback()));
+    if (std::string_view(host) == "proxy.example") {
+      ASSERT_FALSE(request->GetAddressResults().empty());
+      EXPECT_EQ("192.0.2.42:443",
+                request->GetAddressResults().front().ToString());
+    }
+  }
+}
