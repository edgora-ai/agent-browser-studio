+TEST(AgentBrowserLocalDnsPolicyTest, MalformedTypedPolicyDies) {
+  auto policy = mojom::AgentBrowserLocalDnsPolicy::New();
+  policy->mode = static_cast<mojom::AgentBrowserLocalDnsMode>(123);
+  EXPECT_CHECK_DEATH(BuildAgentBrowserHostMappingRules(policy.get()));
+  policy->mode = mojom::AgentBrowserLocalDnsMode::kProxyLocalDnsDeny;
+  policy->proxy_bootstrap_host = "proxy.example, EXCLUDE *";
+  EXPECT_CHECK_DEATH(BuildAgentBrowserHostMappingRules(policy.get()));
+  policy->proxy_bootstrap_host = "";
+  EXPECT_CHECK_DEATH(BuildAgentBrowserHostMappingRules(policy.get()));
+}
