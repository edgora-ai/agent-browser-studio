+// Browser-only opt-in, independent of fingerprint configuration. Invalid or
+// incomplete input CHECK-fails, including when managed strict DoH is enabled.
+// Valid managed strict DoH launches return null and retain their existing path.
+COMPONENT_EXPORT(NETWORK_CPP)
+mojom::AgentBrowserLocalDnsPolicyPtr ParseAgentBrowserLocalDnsPolicy(
+    const base::CommandLine& command_line,
+    bool managed_secure_dns);
+
+// Network-service consumer. Null leaves stock behavior unchanged. Revalidates
+// the typed policy before producing a fixed deny rule and exact exclusions;
+// never accepts caller-supplied mapping rules or replacement addresses.
+COMPONENT_EXPORT(NETWORK_CPP)
+std::string BuildAgentBrowserHostMappingRules(
+    const mojom::AgentBrowserLocalDnsPolicy* policy);
+
+}  // namespace network
