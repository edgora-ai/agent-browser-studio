new file mode 100644
--- /dev/null
+++ b/services/network/public/cpp/agent_browser_local_dns_policy.cc
@@ -0,0 +1,119 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "services/network/public/cpp/agent_browser_local_dns_policy.h"
+
+#include <optional>
+#include <string_view>
+
+#include "base/check.h"
+#include "base/command_line.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "net/base/ip_address.h"
+#include "net/base/url_util.h"
+#include "services/network/public/mojom/network_context.mojom.h"
+#include "url/url_canon.h"
+
+namespace network {
+namespace {
+
+std::optional<std::string> CanonicalBootstrapHost(std::string_view host) {
+  if (host.empty() || host.size() > 253 || !base::IsStringASCII(host)) {
+    return std::nullopt;
+  }
+  std::string_view ip_literal = host;
+  if (ip_literal.front() == '[' && ip_literal.back() == ']') {
+    ip_literal = ip_literal.substr(1, ip_literal.size() - 2);
+  }
+  net::IPAddress address;
+  if (address.AssignFromIPLiteral(ip_literal)) {
+    // Reject shorthand/octal IPv4 and brackets around IPv4. Only IPv6 accepts
+    // alternate equivalent spellings; normalize it to HostPortPair's bare host.
+    const std::string canonical = address.ToString();
+    if (address.IsIPv4() && host != canonical) {
+      return std::nullopt;
+    }
+    return canonical;
+  }
+
+  std::string_view dns_name = host;
+  if (dns_name.back() == '.') {
+    dns_name.remove_suffix(1);
+  }
+  if (dns_name.empty()) {
+    return std::nullopt;
+  }
+  for (std::string_view label : base::SplitStringPiece(
+           dns_name, ".", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    if (label.empty() || label.size() > 63 ||
+        !base::IsAsciiAlphaNumeric(label.front()) ||
+        !base::IsAsciiAlphaNumeric(label.back())) {
+      return std::nullopt;
+    }
+    for (char c : label) {
+      if (!base::IsAsciiAlphaNumeric(c) && c != '-') {
+        return std::nullopt;
+      }
+    }
+  }
+  // Reject noncanonical numeric addresses as DNS names, as the proxy parser
+  // would otherwise canonicalize them to a different host (e.g. 127.1).
+  url::CanonHostInfo host_info;
+  std::string canonical = net::CanonicalizeHost(host, &host_info);
+  if (host_info.family != url::CanonHostInfo::NEUTRAL ||
+      canonical != base::ToLowerASCII(host)) {
+    return std::nullopt;
+  }
+  return canonical;
+}
+
+}  // namespace
+
+mojom::AgentBrowserLocalDnsPolicyPtr ParseAgentBrowserLocalDnsPolicy(
+    const base::CommandLine& command_line,
+    bool managed_secure_dns) {
+  if (!command_line.HasSwitch(kAgentBrowserLocalDnsPolicySwitch)) {
+    CHECK(!command_line.HasSwitch(kAgentBrowserProxyBootstrapHostSwitch))
+        << "Proxy bootstrap host requires the local DNS deny policy";
+    return nullptr;
+  }
+  CHECK(command_line.GetSwitchValueASCII(kAgentBrowserLocalDnsPolicySwitch) ==
+        kAgentBrowserProxyLocalDnsDeny)
+      << "Invalid Agent Browser local DNS policy";
+  auto policy = mojom::AgentBrowserLocalDnsPolicy::New();
+  policy->mode = mojom::AgentBrowserLocalDnsMode::kProxyLocalDnsDeny;
+  if (command_line.HasSwitch(kAgentBrowserProxyBootstrapHostSwitch)) {
+    const std::string host =
+        command_line.GetSwitchValueASCII(kAgentBrowserProxyBootstrapHostSwitch);
+    policy->proxy_bootstrap_host = CanonicalBootstrapHost(host);
+    CHECK(policy->proxy_bootstrap_host.has_value())
+        << "Invalid Agent Browser proxy bootstrap host";
+  }
+  // Validate first: a malformed opt-in must never silently become stock.
+  if (managed_secure_dns) {
+    return nullptr;
+  }
+  return policy;
+}
+
+std::string BuildAgentBrowserHostMappingRules(
+    const mojom::AgentBrowserLocalDnsPolicy* policy) {
+  if (!policy) {
+    return {};
+  }
+  CHECK(policy->mode == mojom::AgentBrowserLocalDnsMode::kProxyLocalDnsDeny)
+      << "Invalid Agent Browser local DNS policy mode";
+  // Chromium 152's MappedHostResolver recognizes ^NOTFOUND, not ~NOTFOUND.
+  // This fails before cache, hosts, system, DNS or secure-DNS resolution.
+  std::string rules = "MAP * ^NOTFOUND, EXCLUDE localhost, EXCLUDE 127.0.0.1";
+  if (policy->proxy_bootstrap_host) {
+    auto host = CanonicalBootstrapHost(*policy->proxy_bootstrap_host);
+    CHECK(host.has_value()) << "Invalid Agent Browser proxy bootstrap host";
+    rules.append(", EXCLUDE ").append(*host);
+  }
+  return rules;
+}
+
+}  // namespace network
