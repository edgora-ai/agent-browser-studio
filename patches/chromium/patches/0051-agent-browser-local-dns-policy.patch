+      switches::kHostResolverRules, "MAP * 127.0.0.1");
+  auto factory = std::make_unique<AgentBrowserPolicyResolverFactory>();
+  auto* factory_ptr = factory.get();
+  network_service_->set_host_resolver_factory_for_testing(std::move(factory));
+  auto params = CreateNetworkContextParamsForTesting();
+  params->agent_browser_local_dns_policy =
+      mojom::AgentBrowserLocalDnsPolicy::New();
+  params->agent_browser_local_dns_policy->proxy_bootstrap_host = "proxy.example";
+  const auto rules = BuildAgentBrowserHostMappingRules(
+      params->agent_browser_local_dns_policy.get());
+  auto context = CreateContextWithParams(std::move(params));
+  EXPECT_THAT(factory_ptr->mappings, ElementsAre(rules));
+  net::HostResolver::ResolveHostParameters parameters;
+  // Hermetic even if a regression removes the mapping: no external DNS I/O.
+  parameters.source = net::HostResolverSource::LOCAL_ONLY;
+  auto request = context->url_request_context()->host_resolver()->CreateRequest(
+      net::HostPortPair("target.example", 443), net::NetworkAnonymizationKey(),
