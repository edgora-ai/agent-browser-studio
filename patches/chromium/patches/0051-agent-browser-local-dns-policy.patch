+// Captures the two production factory entry points without replacing the real
+// HostResolver/MappedHostResolver implementation.
+class AgentBrowserPolicyResolverFactory : public net::HostResolver::Factory {
+ public:
+  std::unique_ptr<net::HostResolver> CreateResolver(
+      net::HostResolverManager* manager,
+      std::string_view rules,
+      bool enable_caching,
+      bool enable_stale) override {
+    mappings.emplace_back(rules);
+    return net::HostResolver::Factory::CreateResolver(
+        manager, rules, enable_caching, enable_stale);
+  }
+  std::unique_ptr<net::HostResolver> CreateStandaloneResolver(
+      net::NetLog* net_log,
+      const net::HostResolver::ManagerOptions& options,
+      std::string_view rules,
+      bool enable_caching,
+      bool enable_stale) override {
+    mappings.emplace_back(rules);
+    return net::HostResolver::Factory::CreateStandaloneResolver(
+        net_log, options, rules, enable_caching, enable_stale);
+  }
+  std::vector<std::string> mappings;
+};
