+    "agent-browser-local-dns-policy";
+inline constexpr char kAgentBrowserProxyBootstrapHostSwitch[] =
+    "agent-browser-proxy-bootstrap-host";
+inline constexpr char kAgentBrowserProxyLocalDnsDeny[] = "proxy-local-dns-deny";
