+TEST(AgentBrowserLocalDnsPolicyTest, StockOffModeAndStrictDohAreSeparate) {
+  base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+  EXPECT_FALSE(ParseAgentBrowserLocalDnsPolicy(command_line, false));
+  EXPECT_FALSE(ParseAgentBrowserLocalDnsPolicy(command_line, true));
+  EXPECT_TRUE(BuildAgentBrowserHostMappingRules(nullptr).empty());
+  // No fingerprint switch/payload is needed, including in native/off mode.
+  command_line.AppendSwitchASCII(kAgentBrowserLocalDnsPolicySwitch,
+                                 kAgentBrowserProxyLocalDnsDeny);
+  auto policy = ParseAgentBrowserLocalDnsPolicy(command_line, false);
+  ASSERT_TRUE(policy);
+  EXPECT_EQ("MAP * ^NOTFOUND, EXCLUDE localhost, EXCLUDE 127.0.0.1",
+            BuildAgentBrowserHostMappingRules(policy.get()));
+  EXPECT_FALSE(ParseAgentBrowserLocalDnsPolicy(command_line, true));
+}
+
+TEST(AgentBrowserLocalDnsPolicyTest, CanonicalBootstrapHostOnly) {
+  const std::pair<const char*, const char*> hosts[] = {
+      {"Proxy.Example", "proxy.example"},
+      {"proxy.example.", "proxy.example."},
+      {"192.0.2.8", "192.0.2.8"},
+      {"[2001:DB8::1]", "2001:db8::1"},
+      {"2001:db8::1", "2001:db8::1"},
+      {"[::1]", "::1"},
+  };
+  for (const auto& [input, expected] : hosts) {
+    SCOPED_TRACE(input);
+    base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+    command_line.AppendSwitchASCII(kAgentBrowserLocalDnsPolicySwitch,
+                                   kAgentBrowserProxyLocalDnsDeny);
+    command_line.AppendSwitchASCII(kAgentBrowserProxyBootstrapHostSwitch,
+                                   input);
+    auto policy = ParseAgentBrowserLocalDnsPolicy(command_line, false);
+    ASSERT_TRUE(policy);
+    ASSERT_TRUE(policy->proxy_bootstrap_host);
+    EXPECT_EQ(expected, *policy->proxy_bootstrap_host);
+    EXPECT_EQ(std::string("MAP * ^NOTFOUND, EXCLUDE localhost, EXCLUDE ") +
+                  "127.0.0.1, EXCLUDE " + expected,
+              BuildAgentBrowserHostMappingRules(policy.get()));
+  }
+}
+
+TEST(AgentBrowserLocalDnsPolicyTest,
+     MalformedCommandLineDiesEvenWithStrictDoh) {
+  for (bool managed_secure_dns : {false, true}) {
+    for (const char* value : {"", "stock", "off", "PROXY-LOCAL-DNS-DENY",
+                              "MAP * 192.0.2.1"}) {
+      base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+      command_line.AppendSwitchASCII(kAgentBrowserLocalDnsPolicySwitch, value);
+      EXPECT_CHECK_DEATH(
+          ParseAgentBrowserLocalDnsPolicy(command_line, managed_secure_dns));
+    }
+    const std::string invalid_hosts[] = {
+        "", "*.example", "proxy?.example", "proxy.example, EXCLUDE *",
+        "proxy.example:80", "http://proxy.example", "user@proxy.example",
+        "proxy example", "proxy\texample", "proxy/example", "proxy\\example",
+        "a..example", "_proxy.example", "-proxy.example", ".", "127.1",
+        "[::1]:80", "[not-ip]", "pr\xc3\xb6xy.example",
+        std::string(64, 'a') + ".example", std::string(254, 'a'),
+    };
+    for (const std::string& host : invalid_hosts) {
+      SCOPED_TRACE(host);
+      base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+      command_line.AppendSwitchASCII(kAgentBrowserLocalDnsPolicySwitch,
+                                     kAgentBrowserProxyLocalDnsDeny);
+      command_line.AppendSwitchUTF8(kAgentBrowserProxyBootstrapHostSwitch,
+                                    host);
+      EXPECT_CHECK_DEATH(
+          ParseAgentBrowserLocalDnsPolicy(command_line, managed_secure_dns));
+    }
+    base::CommandLine incomplete(base::CommandLine::NO_PROGRAM);
+    incomplete.AppendSwitchASCII(kAgentBrowserProxyBootstrapHostSwitch,
+                                 "proxy.example");
+    EXPECT_CHECK_DEATH(
+        ParseAgentBrowserLocalDnsPolicy(incomplete, managed_secure_dns));
+  }
+}
