+RoxyWebAuthnClientCapabilities(const RoxyFingerprintConfig& config) {
+  Vector<mojom::blink::WebAuthnClientCapabilityPtr> capabilities;
+  auto append = [&capabilities](const char* name, bool supported) {
+    auto capability = mojom::blink::WebAuthnClientCapability::New();
+    capability->name = name;
+    capability->supported = supported;
+    capabilities.push_back(std::move(capability));
+  };
+  append("conditionalGet", config.webauthn_conditional_get());
+  append("hybridTransport", config.webauthn_hybrid_transport());
+  append("passkeyPlatformAuthenticator",
+         config.webauthn_passkey_platform_authenticator());
+  append("userVerifyingPlatformAuthenticator",
+         config.webauthn_user_verifying_platform_authenticator());
+  append("relatedOrigins", true);
+  append("conditionalCreate", config.webauthn_conditional_create());
+  append("signalAllAcceptedCredentials", true);
+  append("signalCurrentUserDetails", true);
+  append("signalUnknownCredential", true);
+  return capabilities;
+}
