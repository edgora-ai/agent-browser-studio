diff --git a/chrome/browser/net/roxy_proxy_auth.cc b/chrome/browser/net/roxy_proxy_auth.cc
new file mode 100644
index 0000000..74d3141
--- /dev/null
+++ b/chrome/browser/net/roxy_proxy_auth.cc
@@ -0,0 +1,198 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/net/roxy_proxy_auth.h"
+
+#include <algorithm>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/values.h"
+#include "build/build_config.h"
+#include "net/base/auth.h"
+
+namespace roxy {
+namespace {
+
+constexpr int64_t kMaximumCredentialFileSize = 64 * 1024;
+constexpr size_t kMaximumHostLength = 253;
+constexpr size_t kMaximumUsernameLength = 1024;
+constexpr size_t kMaximumPasswordLength = 4096;
+
+class ManagedProxyLoginDelegate final : public content::LoginDelegate {
+ public:
+  ManagedProxyLoginDelegate(net::AuthCredentials credentials,
+                            LoginAuthRequiredCallback callback)
+      : credentials_(std::move(credentials)), callback_(std::move(callback)) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&ManagedProxyLoginDelegate::Respond,
+                                  weak_factory_.GetWeakPtr()));
+  }
+
+  ManagedProxyLoginDelegate(const ManagedProxyLoginDelegate&) = delete;
+  ManagedProxyLoginDelegate& operator=(const ManagedProxyLoginDelegate&) =
+      delete;
+  ~ManagedProxyLoginDelegate() override = default;
+
+ private:
+  void Respond() {
+    if (callback_) {
+      std::move(callback_).Run(credentials_);
+    }
+  }
+
+  const std::optional<net::AuthCredentials> credentials_;
+  LoginAuthRequiredCallback callback_;
+  base::WeakPtrFactory<ManagedProxyLoginDelegate> weak_factory_{this};
+};
+
+class ManagedProxyAuthState {
+ public:
+  static ManagedProxyAuthState& Get() {
+    static base::NoDestructor<ManagedProxyAuthState> state;
+    return *state;
+  }
+
+  ManagedProxyAuthState(const ManagedProxyAuthState&) = delete;
+  ManagedProxyAuthState& operator=(const ManagedProxyAuthState&) = delete;
+
+  void Initialize() {
+    if (initialized_) {
+      return;
+    }
+    initialized_ = true;
+
+    base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+    const base::FilePath credential_path =
+        command_line->GetSwitchValuePath(kProxyAuthFileSwitch);
+    command_line->RemoveSwitch(kProxyAuthFileSwitch);
+    if (credential_path.empty()) {
+      return;
+    }
+
+    if (!credential_path.IsAbsolute() || base::IsLink(credential_path)) {
+      LOG(ERROR) << "Managed proxy credential file path is unsafe";
+      return;
+    }
+
+#if BUILDFLAG(IS_POSIX)
+    int permissions = 0;
+    if (!base::GetPosixFilePermissions(credential_path, &permissions) ||
+        (permissions & base::FILE_PERMISSION_MASK) !=
+            (base::FILE_PERMISSION_READ_BY_USER |
+             base::FILE_PERMISSION_WRITE_BY_USER)) {
+      LOG(ERROR) << "Managed proxy credential file must have mode 0600";
+      base::DeleteFile(credential_path);
+      return;
+    }
+#endif
+
+    const std::optional<int64_t> file_size = base::GetFileSize(credential_path);
+    if (!file_size || *file_size <= 0 ||
+        *file_size > kMaximumCredentialFileSize) {
+      LOG(ERROR) << "Managed proxy credential file has an invalid size";
+      base::DeleteFile(credential_path);
+      return;
+    }
+
+    std::string json;
+    const bool read = base::ReadFileToString(credential_path, &json);
+    const bool deleted = base::DeleteFile(credential_path);
+    if (!deleted) {
+      LOG(ERROR) << "Managed proxy credential file could not be deleted";
+    }
+    if (!read) {
+      LOG(ERROR) << "Managed proxy credential file could not be read";
+      return;
+    }
+
+    std::optional<base::Value> parsed =
+        base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+    std::fill(json.begin(), json.end(), '\0');
+    if (!parsed || !parsed->is_dict()) {
+      LOG(ERROR) << "Managed proxy credential file is not valid JSON";
+      return;
+    }
+
+    const base::DictValue& dict = parsed->GetDict();
+    const std::optional<int> version = dict.FindInt("version");
+    const std::string* host = dict.FindString("host");
+    const std::optional<int> port = dict.FindInt("port");
+    const std::string* username = dict.FindString("username");
+    const std::string* password = dict.FindString("password");
+    if (version != 1 || !host || !port || !username || !password ||
+        host->empty() || host->size() > kMaximumHostLength || *port < 1 ||
+        *port > 65535 || username->empty() ||
+        username->size() > kMaximumUsernameLength ||
+        password->size() > kMaximumPasswordLength ||
+        host->find_first_of("\r\n\t /@") != std::string::npos) {
+      LOG(ERROR) << "Managed proxy credential fields are invalid";
+      return;
+    }
+
+    host_ = base::ToLowerASCII(*host);
+    port_ = *port;
+    credentials_.emplace(base::UTF8ToUTF16(*username),
+                         base::UTF8ToUTF16(*password));
+  }
+
+  std::optional<net::AuthCredentials> CredentialsFor(
+      const net::AuthChallengeInfo& auth_info,
+      bool first_auth_attempt) const {
+    if (!initialized_ || !credentials_ || !first_auth_attempt ||
+        !auth_info.is_proxy ||
+        !base::EqualsCaseInsensitiveASCII(auth_info.challenger.host(), host_) ||
+        auth_info.challenger.port() != port_ ||
+        (!base::EqualsCaseInsensitiveASCII(auth_info.scheme, "basic") &&
+         !base::EqualsCaseInsensitiveASCII(auth_info.scheme, "digest"))) {
+      return std::nullopt;
+    }
+    return credentials_;
+  }
+
+ private:
+  friend class base::NoDestructor<ManagedProxyAuthState>;
+
+  ManagedProxyAuthState() = default;
+  ~ManagedProxyAuthState() = default;
+
+  bool initialized_ = false;
+  std::string host_;
+  int port_ = 0;
+  std::optional<net::AuthCredentials> credentials_;
+};
+
+}  // namespace
+
+void InitializeManagedProxyAuth() {
+  ManagedProxyAuthState::Get().Initialize();
+}
+
+std::unique_ptr<content::LoginDelegate> MaybeCreateManagedProxyLoginDelegate(
+    const net::AuthChallengeInfo& auth_info,
+    bool first_auth_attempt,
+    content::LoginDelegate::LoginAuthRequiredCallback* callback) {
+  std::optional<net::AuthCredentials> credentials =
+      ManagedProxyAuthState::Get().CredentialsFor(auth_info,
+                                                  first_auth_attempt);
+  if (!credentials) {
+    return nullptr;
+  }
+  return std::make_unique<ManagedProxyLoginDelegate>(std::move(*credentials),
+                                                     std::move(*callback));
+}
+
+}  // namespace roxy
