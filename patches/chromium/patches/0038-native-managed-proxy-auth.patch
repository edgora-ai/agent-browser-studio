+
+#ifndef CHROME_BROWSER_NET_ROXY_PROXY_AUTH_H_
+#define CHROME_BROWSER_NET_ROXY_PROXY_AUTH_H_
+
+#include <memory>
+
+#include "content/public/browser/login_delegate.h"
+
+namespace net {
+class AuthChallengeInfo;
+}
+
+namespace roxy {
+
+inline constexpr char kProxyAuthFileSwitch[] = "roxy-proxy-auth-file";
+inline constexpr char kCapabilitiesSwitch[] = "roxy-capabilities";
+inline constexpr char kProxyAuthCapability[] = "roxy-proxy-auth-file-v1";
+
+// Loads and deletes the one-shot credential file before child processes are
+// started. Calling this more than once has no effect.
+void InitializeManagedProxyAuth();
+
+// Returns a delegate only for a first-attempt proxy challenge matching the
+// configured host and port. Server authentication continues through Chrome's
+// stock UI/extension path.
+std::unique_ptr<content::LoginDelegate> MaybeCreateManagedProxyLoginDelegate(
+    const net::AuthChallengeInfo& auth_info,
+    bool first_auth_attempt,
+    content::LoginDelegate::LoginAuthRequiredCallback* callback);
+
+}  // namespace roxy
+
+#endif  // CHROME_BROWSER_NET_ROXY_PROXY_AUTH_H_
