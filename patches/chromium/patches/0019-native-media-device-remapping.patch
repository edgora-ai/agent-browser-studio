+void RemapRoxyStringConstraint(StringConstraint& constraint) {
+  const RoxyFingerprintConfig& config = RoxyFingerprintConfig::Get();
+  if (constraint.HasExact()) {
+    Vector<String> remapped;
+    for (const String& value : constraint.Exact()) {
+      remapped.push_back(String::FromUtf8(config.MapMediaConstraintToActual(
+          value.Utf8().c_str())));
+    }
+    constraint.SetExact(remapped);
+  }
+  if (constraint.HasIdeal()) {
+    Vector<String> remapped;
+    for (const String& value : constraint.Ideal()) {
+      remapped.push_back(String::FromUtf8(config.MapMediaConstraintToActual(
+          value.Utf8().c_str())));
+    }
+    constraint.SetIdeal(remapped);
+  }
+}
+
+void RemapRoxyMediaConstraints(MediaConstraints& constraints) {
+  const RoxyFingerprintConfig& config = RoxyFingerprintConfig::Get();
+  if (!config.enabled() || !config.media_devices_enabled() ||
+      constraints.IsNull()) {
+    return;
+  }
+  MediaTrackConstraintSetPlatform basic = constraints.Basic();
+  Vector<MediaTrackConstraintSetPlatform> advanced = constraints.Advanced();
+  RemapRoxyStringConstraint(basic.device_id);
+  RemapRoxyStringConstraint(basic.group_id);
+  for (MediaTrackConstraintSetPlatform& constraint_set : advanced) {
+    RemapRoxyStringConstraint(constraint_set.device_id);
+    RemapRoxyStringConstraint(constraint_set.group_id);
+  }
+  MediaConstraints remapped_constraints;
+  remapped_constraints.Initialize(basic, advanced);
+  constraints.Assign(remapped_constraints);
+}
+
