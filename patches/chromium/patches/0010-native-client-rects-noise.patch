+namespace {
+
+uint64_t MixRoxyClientRectNoise(uint64_t value) {
+  value ^= value >> 30;
+  value *= 0xbf58476d1ce4e5b9ULL;
+  value ^= value >> 27;
+  value *= 0x94d049bb133111ebULL;
+  return value ^ (value >> 31);
+}
+
+void ApplyRoxyClientRectNoise(gfx::RectF* rect) {
+  const RoxyFingerprintConfig& config = RoxyFingerprintConfig::Get();
+  if (!config.enabled())
+    return;
+  uint64_t hash = static_cast<uint64_t>(config.seed());
+  hash ^= static_cast<uint64_t>(static_cast<int64_t>(rect->x() * 64.0f));
+  hash = MixRoxyClientRectNoise(hash);
+  hash ^= static_cast<uint64_t>(static_cast<int64_t>(rect->y() * 64.0f));
+  hash = MixRoxyClientRectNoise(hash);
+  hash ^= static_cast<uint64_t>(static_cast<int64_t>(rect->width() * 64.0f));
+  hash = MixRoxyClientRectNoise(hash);
+  hash ^= static_cast<uint64_t>(static_cast<int64_t>(rect->height() * 64.0f));
+  hash = MixRoxyClientRectNoise(hash);
+  const float x_noise =
+      (static_cast<float>(hash & 0xffff) / 65535.0f - 0.5f) / 100.0f;
+  const float y_noise =
+      (static_cast<float>((hash >> 16) & 0xffff) / 65535.0f - 0.5f) /
+      100.0f;
+  rect->set_x(rect->x() + x_noise);
+  rect->set_y(rect->y() + y_noise);
+}
+
+}  // namespace
