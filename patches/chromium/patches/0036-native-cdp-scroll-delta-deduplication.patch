+gfx::Vector2dF LayerTreeHost::SubtractSynchronizedDebuggerScrollDelta(
+    const ElementId& scroll_element,
+    const gfx::Vector2dF& scroll_delta) {
+  auto it = synchronized_debugger_scroll_deltas_.find(scroll_element);
+  if (it == synchronized_debugger_scroll_deltas_.end())
+    return scroll_delta;
+
+  gfx::Vector2dF synchronized_delta = it->second;
+  auto subtract_axis = [](float delta, float* synchronized) {
+    if (delta * *synchronized <= 0.f)
+      return delta;
+    const float amount = std::min(std::abs(delta), std::abs(*synchronized));
+    const float consumed = std::copysign(amount, delta);
+    *synchronized -= consumed;
+    return delta - consumed;
+  };
+
+  float synchronized_x = synchronized_delta.x();
+  float synchronized_y = synchronized_delta.y();
+  gfx::Vector2dF remaining_delta(
+      subtract_axis(scroll_delta.x(), &synchronized_x),
+      subtract_axis(scroll_delta.y(), &synchronized_y));
+  synchronized_delta.set_x(synchronized_x);
+  synchronized_delta.set_y(synchronized_y);
+  if (synchronized_delta.IsZero()) {
+    synchronized_debugger_scroll_deltas_.erase(it);
+  } else {
+    it->second = synchronized_delta;
+  }
+  return remaining_delta;
+}
