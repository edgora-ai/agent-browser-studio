+void ImageDataBuffer::ApplyRoxyFingerprintNoise(SkPixmap pixmap) {
+  const RoxyFingerprintConfig& config = RoxyFingerprintConfig::Get();
+  if (!config.enabled() || !config.canvas_noise_enabled() ||
+      pixmap.info().bytesPerPixel() != 4 || !pixmap.writable_addr()) {
+    return;
+  }
+
+  for (int y = 0; y < pixmap.height(); ++y) {
+    auto* row = static_cast<uint8_t*>(pixmap.writable_addr(0, y));
+    for (int x = 0; x < pixmap.width(); ++x) {
+      uint8_t* pixel = row + x * 4;
+      if (pixel[3] == 0)
+        continue;
+      uint64_t hash = config.canvas_noise_seed();
+      hash ^= static_cast<uint64_t>(y) << 32 | static_cast<uint32_t>(x);
+      hash ^= static_cast<uint64_t>(pixel[0]) << 24 |
+              static_cast<uint64_t>(pixel[1]) << 16 |
+              static_cast<uint64_t>(pixel[2]) << 8 | pixel[3];
+      hash = MixCanvasNoise(hash);
+      const int channel = static_cast<int>(hash % 3);
+      const int delta = (hash & 0x8) ? 1 : -1;
+      pixel[channel] = static_cast<uint8_t>(
+          std::clamp(static_cast<int>(pixel[channel]) + delta, 0, 255));
+    }
+  }
+}
+
+void ImageDataBuffer::ApplyRoxyFingerprintNoise() {
+  const RoxyFingerprintConfig& config = RoxyFingerprintConfig::Get();
+  if (!config.enabled() || !config.canvas_noise_enabled() ||
+      pixmap_.info().bytesPerPixel() != 4) {
+    return;
+  }
+
+  const SkImageInfo info = pixmap_.info();
+  const size_t row_bytes = info.minRowBytes();
+  const size_t size = info.computeByteSize(row_bytes);
+  if (SkImageInfo::ByteSizeOverflowed(size))
+    return;
+  sk_sp<SkData> data = SkData::MakeUninitialized(size);
+  SkPixmap detached(info, data->writable_data(), row_bytes);
+  for (int y = 0; y < info.height(); ++y) {
+    std::memcpy(detached.writable_addr(0, y), pixmap_.addr(0, y), row_bytes);
+  }
+  ApplyRoxyFingerprintNoise(detached);
+  sk_sp<SkImage> detached_image =
+      SkImages::RasterFromData(info, std::move(data), row_bytes);
+  if (!detached_image)
+    return;
+  retained_image_ = std::move(detached_image);
+  pixmap_ = detached;
+}
