+void LocalStorageImpl::FlushForShutdownWhenConnected(
+    FlushForShutdownCallback callback) {
+  // An in-memory database can acknowledge SQL commits but cannot satisfy
+  // restart persistence, so it must never be reported as a confirmed
+  // persistent commit. Answer immediately: waiting would only delay the
+  // caller without changing the outcome.
+  if (in_memory_) {
+    std::move(callback).Run(/*confirmed=*/false);
+    return;
+  }
+
+  // Every storage area must confirm its database write before the caller is
+  // told the flush succeeded.
+  if (areas_.empty()) {
+    // Nothing was pending and nothing failed, so there is no unconfirmed
+    // write.
+    std::move(callback).Run(/*confirmed=*/true);
+    return;
+  }
+
+  // Shared completion state: each area gets its own closure that records its
+  // own result and decrements the counter. A single failure stays sticky, so
+  // one successful area cannot mask another area's failed commit.
+  struct Outcome {
+    size_t pending = 0;
+    bool any_failure = false;
+    bool finalized = false;
+    FlushForShutdownCallback callback;
+  };
+  auto outcome = std::make_shared<Outcome>();
+  outcome->pending = areas_.size();
+  outcome->callback = std::move(callback);
+  for (const auto& it : areas_) {
+    it.second->storage_area()->ScheduleImmediateCommitWithCallback(
+        base::BindOnce(
+            [](std::shared_ptr<Outcome> outcome, bool confirmed) {
+              if (outcome->finalized) {
+                return;
+              }
+              if (!confirmed) {
+                outcome->any_failure = true;
+              }
+              if (--outcome->pending != 0) {
+                return;
+              }
+              outcome->finalized = true;
+              FlushForShutdownCallback done = std::move(outcome->callback);
+              if (done) {
+                std::move(done).Run(!outcome->any_failure);
+              }
+            },
+            outcome));
+  }
+}
