+    // non-default partitions without creating or loading missing ones, and it
+    // never calls GetDefaultStoragePartition(), which would create an unused
+    // partition. A partition that was never loaded has no in-process pending
+    // writes, so skipping it loses nothing.
+    std::set<Profile*> profiles;
