+  // A managed fingerprint is one coherent browser identity. Automation
+  // frameworks routinely issue Emulation.setUserAgentOverride for every page
+  // target; accepting that value here would let navigation/subresource
+  // headers disagree with Navigator and with out-of-process subframes. Keep
+  // the command successful, but make all DevTools network consumers use the
+  // same immutable profile values and UA metadata.
+  const blink::RoxyFingerprintConfig& roxy_config =
+      blink::RoxyFingerprintConfig::Get();
+  if (roxy_config.enabled()) {
+    user_agent_ = roxy_config.user_agent();
+    accept_language_ = roxy_config.accept_languages();
+    user_agent_metadata_ = roxy_config.GetUserAgentMetadata(false);
+    return Response::FallThrough();
+  }
