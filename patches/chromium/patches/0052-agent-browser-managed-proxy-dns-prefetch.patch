+bool LoadingPredictor::ShouldPreresolveThroughProxy() {
+  const auto& config = blink::RoxyFingerprintConfig::Get();
+  if (!config.enabled() || !config.secure_dns_enabled() ||
+      config.secure_dns_templates().empty()) {
+    return false;
+  }
+  std::string templates;
+  for (const std::string& server : config.secure_dns_templates()) {
+    if (!templates.empty())
+      templates.append(" ");
+    templates.append(server);
+  }
+  const auto doh_config = net::DnsOverHttpsConfig::FromString(templates);
+  return doh_config.has_value() && !doh_config->servers().empty();
+}
