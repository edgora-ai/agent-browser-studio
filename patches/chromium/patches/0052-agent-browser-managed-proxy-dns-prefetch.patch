+TEST_F(PreconnectManagerImplTest, TestProxyDnsOnlyRequiresEmbedderOptIn) {
+  mock_network_context_->EnableProxyTesting();
+  const GURL origin("https://dns-only.example");
+  const auto key = CreateNetworkAnonymizationKey(origin);
+  EXPECT_CALL(*mock_delegate_, IsPreconnectEnabled()).WillOnce(Return(true));
+  preconnect_manager_->StartPreresolveHost(
+      origin, key, TRAFFIC_ANNOTATION_FOR_TESTS, nullptr,
+      network::GetTestNetworkRestrictionsId());
+  // StrictMock rejects any DNS request or socket without the opt-in.
+  mock_network_context_->CompleteProxyLookup(origin, GetIndirectProxyInfo());
+}
+
+TEST_F(PreconnectManagerImplTest, TestProxyDnsOnlyUsesAllowedSecureRoute) {
+  mock_network_context_->EnableProxyTesting();
+  mock_delegate_->set_preresolve_through_proxy(true);
+  const GURL origin("https://dns-only.example");
+  const auto key = CreateNetworkAnonymizationKey(origin);
+  EXPECT_CALL(*mock_delegate_, IsPreconnectEnabled()).WillOnce(Return(true));
+  EXPECT_CALL(*mock_network_context_, ResolveHostProxy(origin.GetHost()));
+  preconnect_manager_->StartPreresolveHost(
+      origin, key, TRAFFIC_ANNOTATION_FOR_TESTS, nullptr,
+      network::GetTestNetworkRestrictionsId());
+  mock_network_context_->CompleteProxyLookup(origin, GetIndirectProxyInfo());
+  mock_network_context_->CompleteHostLookup(origin.GetHost(), key, net::OK);
+}
+
+TEST_F(PreconnectManagerImplTest, TestProxyDnsOptInStillSkipsMulticastNames) {
+  mock_network_context_->EnableProxyTesting();
+  mock_delegate_->set_preresolve_through_proxy(true);
+  for (const char* name : {"https://probe.local", "https://probe.local.",
+                           "https://PROBE.LOCAL"}) {
+    const GURL origin(name);
+    const auto key = CreateNetworkAnonymizationKey(origin);
+    EXPECT_CALL(*mock_delegate_, IsPreconnectEnabled()).WillOnce(Return(true));
+    preconnect_manager_->StartPreresolveHost(
+        origin, key, TRAFFIC_ANNOTATION_FOR_TESTS, nullptr,
+        network::GetTestNetworkRestrictionsId());
+    // StrictMock rejects reaching ANY/system/multicast DNS for these hints.
+    mock_network_context_->CompleteProxyLookup(origin, GetIndirectProxyInfo());
+    VerifyAndClearExpectations();
+  }
+}
