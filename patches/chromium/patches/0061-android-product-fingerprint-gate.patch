+    // The Android product profile provisions per-profile canvas/audio
+    // differentiation through its own reviewed frozen argv
+    // (agent-browser-noise-seeds). That payload is parsed ONLY for the
+    // noise fields: the historical agent-browser-fingerprint-config switch
+    // carries the timezone payload on Android, and the desktop
+    // platform/UA gates and overrides do not apply there, so enabled_
+    // stays false and the noise consumers gate on the dedicated
+    // *_noise_active() accessors. Seeds are decimal strings parsed with
+    // exact uint64 conversion because JSON numbers lose precision above
+    // 2^53.
+    if (command_line->HasSwitch("agent-browser-product-profile") &&
+        command_line->HasSwitch("agent-browser-noise-seeds")) {
+      std::string decoded_noise;
+      const std::string encoded_noise =
+          command_line->GetSwitchValueASCII("agent-browser-noise-seeds");
+      if (encoded_noise.size() <= kMaxConfigBytes &&
+          base::Base64UrlDecode(encoded_noise,
+                                base::Base64UrlDecodePolicy::IGNORE_PADDING,
+                                &decoded_noise)) {
+        auto noise_root =
+            base::JSONReader::ReadDict(decoded_noise, base::JSON_PARSE_RFC);
+        if (noise_root &&
+            noise_root->FindInt("schemaVersion").value_or(0) == 1) {
+          if (const base::DictValue* canvas =
+                  noise_root->FindDict("canvas")) {
+            canvas_noise_enabled_ =
+                canvas->FindBool("enabled").value_or(false);
+            canvas_noise_seed_ = ParseNoiseSeed(*canvas, "seed");
+          }
+          if (const base::DictValue* audio = noise_root->FindDict("audio")) {
+            audio_noise_enabled_ = audio->FindBool("enabled").value_or(false);
+            audio_noise_seed_ = ParseNoiseSeed(*audio, "seed");
+            audio_noise_amplitude_ =
+                audio->FindDouble("amplitude").value_or(0.0);
+          }
+        }
+      }
+      return;
+    }
     enabled_ = seed_ > 0 &&
