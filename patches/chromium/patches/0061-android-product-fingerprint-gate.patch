+  static uint64_t ParseNoiseSeed(const base::DictValue& dict,
+                                 std::string_view key) {
+    const std::string* value = dict.FindString(key);
+    uint64_t seed = 0;
+    if (!value || value->empty() || value->size() > 20 ||
+        !base::StringToUint64(*value, &seed)) {
+      return 0;
+    }
+    return seed;
   }
 
