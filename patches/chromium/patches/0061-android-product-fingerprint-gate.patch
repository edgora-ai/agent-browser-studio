+  // Per-profile noise gates. The Android product profile drives canvas and
+  // audio differentiation through these without flipping enabled(), so the
+  // desktop platform/UA overrides stay inert there; on desktop the canvas
+  // gate equals enabled() && canvas_noise_enabled() because HashSeed never
+  // yields 0, and audio additionally requires a positive amplitude (a
+  // zero-amplitude desktop payload was an arithmetic no-op anyway).
+  bool canvas_noise_active() const {
+    return canvas_noise_enabled_ && canvas_noise_seed_ != 0;
+  }
+  bool audio_noise_active() const {
+    return audio_noise_enabled_ && audio_noise_seed_ != 0 &&
+           audio_noise_amplitude_ > 0.0;
+  }
