+  // Resolve CSS generic families to fonts that belong to the declared
+  // platform rather than the host OS. The Windows choices are deliberately
+  // limited to the portable Microsoft families present on supported macOS
+  // builders; profile-scoped runtime fonts can later provide exact Segoe and
+  // regional families without exposing unrelated host fonts.
+  std::optional<std::string> ManagedGenericFontFamily(
+      std::string_view family) const {
+    if (!enabled_ || platform_ != "Win32")
+      return std::nullopt;
+    const std::string normalized = LowerAscii(family);
+    if (normalized == "serif" || normalized == "ui-serif" ||
+        normalized == "math" || normalized == "times") {
+      return "Times New Roman";
+    }
+    if (normalized == "sans-serif" || normalized == "ui-sans-serif" ||
+        normalized == "helvetica" || normalized == "helvetica neue") {
+      return "Arial";
+    }
+    if (normalized == "monospace" || normalized == "ui-monospace" ||
+        normalized == "courier" || normalized == "menlo" ||
+        normalized == "monaco") {
+      return "Courier New";
+    }
+    if (normalized == "cursive" || normalized == "apple chancery")
+      return "Comic Sans MS";
+    if (normalized == "fantasy" || normalized == "papyrus")
+      return "Impact";
+    if (normalized == "system-ui" || normalized == "ui-rounded" ||
+        normalized == "lucida grande" ||
+        normalized == ".applesystemuifont") {
+      return "Tahoma";
+    }
+    if (normalized == "emoji" || normalized == "fangsong")
+      return "Arial Unicode MS";
+    return std::nullopt;
+  }
+
