+enum class ManagedThemePlatform {
+  kNone,
+  kWindows,
+  kMac,
+};
+
+ManagedThemePlatform GetManagedThemePlatform() {
+  const RoxyFingerprintConfig& config = RoxyFingerprintConfig::Get();
+  if (!config.enabled())
+    return ManagedThemePlatform::kNone;
+  return config.platform() == "Win32" ? ManagedThemePlatform::kWindows
+                                      : ManagedThemePlatform::kMac;
+}
+
+struct ManagedThemePalette {
+  Color accent;
+  Color accent_text;
+  Color active_text;
+  Color button_border;
+  Color button_face;
+  Color button_text;
+  Color canvas;
+  Color canvas_text;
+  Color field;
+  Color field_text;
+  Color gray_text;
+  Color highlight;
+  Color highlight_text;
+  Color link_text;
+  Color mark;
+  Color mark_text;
+  Color selected_item;
+  Color selected_item_text;
+  Color visited_text;
+  Color active_selection_background;
+  Color inactive_selection_background;
+  Color active_selection_foreground;
+  Color inactive_selection_foreground;
+};
+
+ManagedThemePalette GetManagedThemePalette(
+    ManagedThemePlatform platform,
+    mojom::blink::ColorScheme color_scheme) {
+  const bool dark = color_scheme == mojom::blink::ColorScheme::kDark;
+  ManagedThemePalette palette;
+  palette.accent = Color(0x00, 0x75, 0xFF);
+  palette.accent_text = Color::kWhite;
+  palette.active_text = Color(0xFF, 0x00, 0x00);
+  palette.button_border = dark ? Color::kWhite : Color::kBlack;
+  palette.button_face = dark ? Color(0x6B, 0x6B, 0x6B)
+                             : Color(0xEF, 0xEF, 0xEF);
+  palette.button_text = dark ? Color::kWhite : Color::kBlack;
+  palette.canvas = dark ? Color(0x12, 0x12, 0x12) : Color::kWhite;
+  palette.canvas_text = dark ? Color::kWhite : Color::kBlack;
+  palette.field = dark ? Color(0x3B, 0x3B, 0x3B) : Color::kWhite;
+  palette.field_text = dark ? Color::kWhite : Color::kBlack;
+  palette.gray_text = Color(0x80, 0x80, 0x80);
+  palette.highlight = Color(0x19, 0x67, 0xD2).BlendWithWhite();
+  palette.highlight_text = Color::kWhite;
+  palette.link_text = dark ? Color(0x9E, 0x9E, 0xFF)
+                           : Color(0x00, 0x00, 0xEE);
+  palette.mark = Color(0xFF, 0xFF, 0x00);
+  palette.mark_text = Color::kBlack;
+  palette.selected_item = dark ? Color(0x99, 0xC8, 0xFF)
+                               : Color(0x19, 0x67, 0xD2);
+  palette.selected_item_text = dark ? Color(0x3B, 0x3B, 0x3B)
+                                    : Color::kWhite;
+  palette.visited_text = dark ? Color(0xD0, 0xAD, 0xF0)
+                              : Color(0x55, 0x1A, 0x8B);
+  palette.active_selection_background =
+      Color(0x19, 0x67, 0xD2).BlendWithWhite();
+  palette.inactive_selection_background =
+      Color(0xC8, 0xC8, 0xC8).BlendWithWhite();
+  palette.active_selection_foreground = Color::kWhite;
+  palette.inactive_selection_foreground = Color::kBlack;
+
+  if (platform == ManagedThemePlatform::kWindows && !dark) {
+    // Windows 11's standard light system palette. Chromium intentionally uses
+    // its renderer selection colors separately from CSS Highlight.
+    palette.active_text = Color(0x00, 0x66, 0xCC);
+    palette.button_face = Color(0xF0, 0xF0, 0xF0);
+    palette.gray_text = Color(0x6D, 0x6D, 0x6D);
+    palette.highlight = Color(0x00, 0x78, 0xD4).BlendWithWhite();
+    palette.highlight_text = Color::kWhite;
+    palette.link_text = Color(0x00, 0x66, 0xCC);
+    palette.visited_text = Color(0x00, 0x66, 0xCC);
+  }
+
+  if (platform == ManagedThemePlatform::kMac) {
+    // These are Chromium's default Aqua/Dark Aqua values. Fixing them to the
+    // declared persona prevents the macOS host accent from leaking into a
+    // managed Windows profile and keeps managed Mac profiles restart-stable.
+    palette.highlight = dark ? Color(0xB3, 0xD7, 0xFF, 204)
+                             : Color(0xB3, 0xD7, 0xFF).BlendWithWhite();
+    palette.highlight_text = Color::kBlack;
+    palette.selected_item = dark ? Color(0x99, 0xC8, 0xFF)
+                                 : Color(0xB3, 0xD7, 0xFF);
+    palette.selected_item_text =
+        dark ? Color(0x3B, 0x3B, 0x3B) : Color::kBlack;
+    palette.active_selection_background =
+        dark ? Color(0x3F, 0x63, 0x8B, 204)
+             : Color(0xB3, 0xD7, 0xFF).BlendWithWhite();
+    palette.inactive_selection_background =
+        (dark ? Color(0x46, 0x46, 0x46) : Color(0xDC, 0xDC, 0xDC))
+            .BlendWithWhite();
+    palette.active_selection_foreground = Color::kBlack;
+    palette.inactive_selection_foreground = Color::kBlack;
+  }
+
+  return palette;
+}
