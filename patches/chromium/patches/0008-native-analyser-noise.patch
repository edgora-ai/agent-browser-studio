+uint64_t MixRoxyAnalyserNoise(uint64_t value) {
+  value ^= value >> 30;
+  value *= 0xbf58476d1ce4e5b9ULL;
+  value ^= value >> 27;
+  value *= 0x94d049bb133111ebULL;
+  return value ^ (value >> 31);
+}
+
+void ApplyRoxyFloatNoise(base::span<float> values, uint64_t salt) {
+  const RoxyFingerprintConfig& config = RoxyFingerprintConfig::Get();
+  if (!config.enabled() || !config.audio_noise_enabled())
+    return;
+  const double amplitude = config.audio_noise_amplitude() * 1000.0;
+  uint64_t state = config.audio_noise_seed() ^ salt;
+  for (size_t index = 0; index < values.size(); ++index) {
+    state = MixRoxyAnalyserNoise(state ^ index);
+    const double unit = static_cast<double>(state & 0xffff) / 65535.0;
+    values[index] += static_cast<float>((unit * 2.0 - 1.0) * amplitude);
+  }
+}
+
+void ApplyRoxyByteNoise(base::span<unsigned char> values, uint64_t salt) {
+  const RoxyFingerprintConfig& config = RoxyFingerprintConfig::Get();
+  if (!config.enabled() || !config.audio_noise_enabled())
+    return;
+  uint64_t state = config.audio_noise_seed() ^ salt;
+  for (size_t index = 0; index < values.size(); ++index) {
+    state = MixRoxyAnalyserNoise(state ^ index);
+    const int delta = (state & 1) ? 1 : -1;
+    values[index] = static_cast<unsigned char>(
+        std::clamp(static_cast<int>(values[index]) + delta, 0, UCHAR_MAX));
+  }
+}
+
