+// Use of this source code is governed by a BSD-style license.
+
+#ifndef THIRD_PARTY_BLINK_PUBLIC_COMMON_AGENT_BROWSER_ANDROID_TIMEZONE_CONFIG_H_
+#define THIRD_PARTY_BLINK_PUBLIC_COMMON_AGENT_BROWSER_ANDROID_TIMEZONE_CONFIG_H_
+
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_ANDROID)
+#include <string>
+#include <string_view>
+
+#include "base/base64url.h"
+#include "base/command_line.h"
+#include "base/json/json_reader.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "crypto/hash.h"
+#include "third_party/icu/source/i18n/unicode/timezone.h"
+
+namespace blink {
+
+// A deliberately separate Android contract. The legacy desktop parser remains
+// disabled for these payloads; this class never enables a desktop persona.
+class AgentBrowserAndroidTimezoneConfig {
+ public:
+  static constexpr char kConfigSwitch[] = "agent-browser-fingerprint-config";
+  static constexpr char kLegacySwitch[] = "roxy-fingerprint-config";
+  static constexpr char kRequiredSwitch[] = "agent-browser-timezone-required";
+
+  static const AgentBrowserAndroidTimezoneConfig& Get() {
+    static const base::NoDestructor<AgentBrowserAndroidTimezoneConfig> config;
+    return *config;
+  }
+
+  bool requested() const { return requested_; }
+  bool valid() const { return valid_; }
+  bool startup_invalid() const { return requested_ && !valid_; }
+  bool timezone_only() const { return valid_ && mode_ == "timezone-only"; }
+  bool native_control() const { return valid_ && mode_ == "native-control"; }
+  const std::string& canonical_timezone() const { return canonical_timezone_; }
+  const std::string& config_sha256() const { return config_sha256_; }
+  const std::string& launch_id() const { return launch_id_; }
+
+ private:
+  friend class base::NoDestructor<AgentBrowserAndroidTimezoneConfig>;
+  friend class AgentBrowserAndroidTimezoneConfigTestPeer;
+
+  AgentBrowserAndroidTimezoneConfig()
+      : AgentBrowserAndroidTimezoneConfig(
+            *base::CommandLine::ForCurrentProcess()) {}
+
+  explicit AgentBrowserAndroidTimezoneConfig(
+      const base::CommandLine& command_line) {
+    constexpr size_t kMaxConfigBytes = 64 * 1024;
+    const char* selected = command_line.HasSwitch(kConfigSwitch)
+                               ? kConfigSwitch : kLegacySwitch;
+    const bool has_payload = command_line.HasSwitch(selected);
+    requested_ = has_payload || command_line.HasSwitch(kRequiredSwitch);
+    if (!has_payload || command_line.HasSwitch("js-flags"))
+      return;
+
+    const std::string encoded = command_line.GetSwitchValueASCII(selected);
+    if (encoded.empty() || encoded.size() > 4 * ((kMaxConfigBytes + 2) / 3))
+      return;
+    // Two contradictory aliases are not a recovery path for a bad public flag.
+    if (command_line.HasSwitch(kConfigSwitch) &&
+        command_line.HasSwitch(kLegacySwitch) &&
+        encoded != command_line.GetSwitchValueASCII(kLegacySwitch)) {
+      return;
+    }
+    std::string decoded;
+    if (!base::Base64UrlDecode(encoded,
+                              base::Base64UrlDecodePolicy::DISALLOW_PADDING,
+                              &decoded) || decoded.size() > kMaxConfigBytes) {
+      return;
+    }
+    std::string reencoded;
+    base::Base64UrlEncode(decoded, base::Base64UrlEncodePolicy::OMIT_PADDING,
+                          &reencoded);
+    if (reencoded != encoded)
+      return;
+    auto root = base::JSONReader::ReadDict(decoded, base::JSON_PARSE_RFC);
+    if (!root || root->FindInt("schemaVersion").value_or(0) != 1)
+      return;
+    const std::string* mode = root->FindString("mode");
+    const std::string* profile_id = root->FindString("profileId");
+    const std::string* launch_id = root->FindString("launchId");
+    if (!mode || !profile_id || !launch_id || !IsUuidV4(*profile_id) ||
+        !IsUuidV4(*launch_id)) {
+      return;
+    }
+    const bool override_requested = *mode == "timezone-only";
+    if ((!override_requested && *mode != "native-control") ||
+        root->size() != (override_requested ? 5u : 4u)) {
+      return;
+    }
+    const std::string* timezone = root->FindString("timezone");
+    if (override_requested && (!timezone || !IsTimezoneToken(*timezone)))
+      return;
+    // Exact, small canonical JSON prevents duplicate-key ambiguity, coercions,
+    // extra desktop fields and escaped lookalike identifiers across runtimes.
+    std::string canonical = "{\"launchId\":\"" + *launch_id +
+        "\",\"mode\":\"" + *mode + "\",\"profileId\":\"" + *profile_id +
+        "\",\"schemaVersion\":1";
+    if (override_requested)
+      canonical += ",\"timezone\":\"" + *timezone + "\"";
+    canonical += "}";
+    if (decoded != canonical)
+      return;
+    if (override_requested) {
+      UErrorCode status = U_ZERO_ERROR;
+      UBool is_system_id = false;
+      icu::UnicodeString canonical_id;
+      icu::TimeZone::getCanonicalID(
+          icu::UnicodeString(timezone->c_str(), -1, US_INV), canonical_id,
+          is_system_id, status);
+      if (U_FAILURE(status) || !is_system_id ||
+          canonical_id == icu::UnicodeString("Etc/Unknown", -1, US_INV)) {
+        return;
+      }
+      canonical_id.toUTF8String(canonical_timezone_);
+    }
+    mode_ = *mode;
+    launch_id_ = *launch_id;
+    config_sha256_ = base::HexEncodeLower(crypto::hash::Sha256(decoded));
+    valid_ = true;
+  }
+
+  static bool IsUuidV4(std::string_view value) {
+    if (value.size() != 36 || value[14] != '4' ||
+        std::string_view("89ab").find(value[19]) == std::string_view::npos) {
+      return false;
+    }
+    for (size_t i = 0; i < value.size(); ++i) {
+      if (i == 8 || i == 13 || i == 18 || i == 23) {
+        if (value[i] != '-')
+          return false;
+      } else if (!(base::IsAsciiDigit(value[i]) ||
+                   (value[i] >= 'a' && value[i] <= 'f'))) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  static bool IsTimezoneToken(std::string_view value) {
+    if (value.empty() || value.size() > 128)
+      return false;
+    for (const char c : value) {
+      if (!base::IsAsciiAlphaNumeric(c) && c != '/' && c != '_' &&
+          c != '+' && c != '-') {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  bool requested_ = false;
+  bool valid_ = false;
+  std::string mode_;
+  std::string canonical_timezone_;
+  std::string config_sha256_;
+  std::string launch_id_;
+};
+
+}  // namespace blink
+#endif  // BUILDFLAG(IS_ANDROID)
+#endif  // THIRD_PARTY_BLINK_PUBLIC_COMMON_AGENT_BROWSER_ANDROID_TIMEZONE_CONFIG_H_
