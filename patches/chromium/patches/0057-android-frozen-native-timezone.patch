+// Copyright 2026 The Agent Browser Studio Authors
+// Use of this source code is governed by a BSD-style license.
+
+#include "third_party/blink/public/common/agent_browser_android_timezone_config.h"
+
+#if BUILDFLAG(IS_ANDROID)
+#include <memory>
+#include <utility>
+
+#include "base/base64url.h"
+#include "base/command_line.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/blink/public/common/roxy_fingerprint_config.h"
+
+namespace blink {
+
+class AgentBrowserAndroidTimezoneConfigTestPeer {
+ public:
+  static std::unique_ptr<AgentBrowserAndroidTimezoneConfig> Parse(
+      const base::CommandLine& command_line) {
+    return std::unique_ptr<AgentBrowserAndroidTimezoneConfig>(
+        new AgentBrowserAndroidTimezoneConfig(command_line));
+  }
+};
+
+namespace {
+constexpr char kNewYork[] =
+    "{\"launchId\":\"22222222-2222-4222-8222-222222222222\","
+    "\"mode\":\"timezone-only\","
+    "\"profileId\":\"11111111-1111-4111-8111-111111111111\","
+    "\"schemaVersion\":1,\"timezone\":\"America/New_York\"}";
+
+std::string Encode(std::string_view json) {
+  std::string encoded;
+  base::Base64UrlEncode(json, base::Base64UrlEncodePolicy::OMIT_PADDING, &encoded);
+  return encoded;
+}
+
+base::CommandLine Command(std::string_view json) {
+  base::CommandLine command(base::CommandLine::NO_PROGRAM);
+  command.AppendSwitchASCII(AgentBrowserAndroidTimezoneConfig::kConfigSwitch,
+                            Encode(json));
+  command.AppendSwitch(AgentBrowserAndroidTimezoneConfig::kRequiredSwitch);
+  return command;
+}
+
+TEST(AgentBrowserAndroidTimezoneConfigTest, AbsentIsNotAnOverride) {
+  base::CommandLine command(base::CommandLine::NO_PROGRAM);
+  const auto config = AgentBrowserAndroidTimezoneConfigTestPeer::Parse(command);
+  EXPECT_FALSE(config->requested());
+  EXPECT_FALSE(config->valid());
+  EXPECT_FALSE(config->startup_invalid());
+  EXPECT_FALSE(config->timezone_only());
+}
+
+TEST(AgentBrowserAndroidTimezoneConfigTest, MissingRequiredPayloadIsInvalid) {
+  base::CommandLine command(base::CommandLine::NO_PROGRAM);
+  command.AppendSwitch(AgentBrowserAndroidTimezoneConfig::kRequiredSwitch);
+  EXPECT_TRUE(AgentBrowserAndroidTimezoneConfigTestPeer::Parse(command)
+                  ->startup_invalid());
+}
+
+TEST(AgentBrowserAndroidTimezoneConfigTest, NewYorkUsesIcuSystemIdentity) {
+  const auto config = AgentBrowserAndroidTimezoneConfigTestPeer::Parse(Command(kNewYork));
+  ASSERT_TRUE(config->valid());
+  EXPECT_TRUE(config->timezone_only());
+  EXPECT_FALSE(config->native_control());
+  EXPECT_EQ("America/New_York", config->canonical_timezone());
+  EXPECT_EQ(64u, config->config_sha256().size());
+  EXPECT_EQ("22222222-2222-4222-8222-222222222222", config->launch_id());
+}
+
+TEST(AgentBrowserAndroidTimezoneConfigTest, NativeControlHasNoTimezone) {
+  const auto config = AgentBrowserAndroidTimezoneConfigTestPeer::Parse(Command(
+      "{\"launchId\":\"22222222-2222-4222-8222-222222222222\","
+      "\"mode\":\"native-control\","
+      "\"profileId\":\"11111111-1111-4111-8111-111111111111\","
+      "\"schemaVersion\":1}"));
+  ASSERT_TRUE(config->valid());
+  EXPECT_TRUE(config->native_control());
+  EXPECT_FALSE(config->timezone_only());
+  EXPECT_TRUE(config->canonical_timezone().empty());
+}
+
+TEST(AgentBrowserAndroidTimezoneConfigTest, InvalidInputsNeverBecomeNativeControl) {
+  for (const auto& change : {
+           std::pair<std::string, std::string>{"America/New_York", "NoSuch/Zone"},
+           {"America/New_York", "GMT+05:30"},
+           {"America/New_York", "Etc/Unknown"},
+           {"America/New_York", ""},
+           {"America/New_York", "America/New_York "},
+           {"\"schemaVersion\":1", "\"schemaVersion\":2"},
+           {"\"schemaVersion\":1", "\"schemaVersion\":true"},
+           {"\"schemaVersion\":1", "\"schemaVersion\":1.0"},
+           {"timezone-only", "desktop"},
+           {"timezone-only", "native-control"},
+           {"11111111-1111-4111-8111-111111111111", "bad-profile"},
+           {"22222222-2222-4222-8222-222222222222", "bad-launch"},
+           {"11111111-1111-4111-8111-111111111111", "11111111-1111-1111-8111-111111111111"},
+           {"\"mode\":\"timezone-only\",", "\"mode\":\"timezone-only\",\"platform\":\"Win32\","},
+           {"\"schemaVersion\":1", "\"schemaVersion\":1,\"schemaVersion\":1"},
+           {"\"timezone\":", " \"timezone\":"},
+       }) {
+    std::string json(kNewYork);
+    const auto at = json.find(change.first);
+    ASSERT_NE(std::string::npos, at);
+    json.replace(at, change.first.size(), change.second);
+    const auto config = AgentBrowserAndroidTimezoneConfigTestPeer::Parse(Command(json));
+    EXPECT_TRUE(config->startup_invalid()) << change.second;
+    EXPECT_FALSE(config->native_control());
+    EXPECT_FALSE(config->timezone_only());
+  }
+}
+
+TEST(AgentBrowserAndroidTimezoneConfigTest, CorruptPublicNeverFallsBackToLegacy) {
+  auto command = Command(kNewYork);
+  command.AppendSwitchASCII(AgentBrowserAndroidTimezoneConfig::kConfigSwitch, "broken!");
+  command.AppendSwitchASCII(AgentBrowserAndroidTimezoneConfig::kLegacySwitch, Encode(kNewYork));
+  EXPECT_TRUE(AgentBrowserAndroidTimezoneConfigTestPeer::Parse(command)->startup_invalid());
+}
+
+TEST(AgentBrowserAndroidTimezoneConfigTest, LegacyOnlyStillUsesTheSameContract) {
+  base::CommandLine command(base::CommandLine::NO_PROGRAM);
+  command.AppendSwitchASCII(AgentBrowserAndroidTimezoneConfig::kLegacySwitch, Encode(kNewYork));
+  EXPECT_TRUE(AgentBrowserAndroidTimezoneConfigTestPeer::Parse(command)->timezone_only());
+}
+
+TEST(AgentBrowserAndroidTimezoneConfigTest, OversizedOrPaddedEncodingIsRejected) {
+  for (const std::string& encoded : {std::string(90000, 'A'), Encode(kNewYork) + "=", std::string("!")}) {
+    base::CommandLine command(base::CommandLine::NO_PROGRAM);
+    command.AppendSwitchASCII(AgentBrowserAndroidTimezoneConfig::kConfigSwitch, encoded);
+    EXPECT_TRUE(AgentBrowserAndroidTimezoneConfigTestPeer::Parse(command)->startup_invalid());
+  }
+}
+
+TEST(AgentBrowserAndroidTimezoneConfigTest, V8TimezoneRedetectionFlagsAreNotAllowed) {
+  auto command = Command(kNewYork);
+  command.AppendSwitchASCII("js-flags", "--no-icu-timezone-data");
+  EXPECT_TRUE(AgentBrowserAndroidTimezoneConfigTestPeer::Parse(command)->startup_invalid());
+}
+
+TEST(AgentBrowserAndroidTimezoneConfigTest, ParsedSnapshotDoesNotFollowLaterCommandChanges) {
+  auto command = Command(kNewYork);
+  const auto config = AgentBrowserAndroidTimezoneConfigTestPeer::Parse(command);
+  ASSERT_TRUE(config->timezone_only());
+  const auto digest = config->config_sha256();
+  command.RemoveSwitch(AgentBrowserAndroidTimezoneConfig::kConfigSwitch);
+  EXPECT_EQ(digest, config->config_sha256());
+  EXPECT_EQ("America/New_York", config->canonical_timezone());
+}
+
+}  // namespace
+}  // namespace blink
+#endif  // BUILDFLAG(IS_ANDROID)
