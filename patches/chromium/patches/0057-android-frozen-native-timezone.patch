--- /dev/null
+++ b/content/shell/android/shell_apk/src/org/chromium/content_shell_apk/AgentBrowserTimezoneApplication.java
@@ -0,0 +1,153 @@
+// Copyright 2026 The Agent Browser Studio Authors
+// Use of this source code is governed by a BSD-style license.
+
+package org.chromium.content_shell_apk;
+
+import android.app.Application;
+import android.content.Context;
+import android.util.Base64;
+
+import org.chromium.base.CommandLine;
+import org.chromium.base.Log;
+
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.UUID;
+
+/** Internal native-kernel fixture only; no Intent or writable command-line-file configuration. */
+public final class AgentBrowserTimezoneApplication extends ContentShellApplication {
+    private static final String TAG = "ABSTimezone";
+    private static final String CONFIG_SWITCH = "agent-browser-fingerprint-config";
+    private static final String REQUIRED_SWITCH = "agent-browser-timezone-required";
+    private static final String ASSET = "agent_browser_timezone_fixture.json";
+    private static final String UUID_V4 =
+            "[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}";
+    private String mEncoded = "";
+    private String mProfileId = "";
+
+    @Override
+    protected void attachBaseContext(Context base) {
+        // This is intentionally before even the parent Application's LibraryLoader access.
+        // Child services receive the frozen argv from native child-process launch instead.
+        if (base.getPackageName().equals(Application.getProcessName())) {
+            freezeBeforeNative(base);
+        }
+        super.attachBaseContext(base);
+    }
+
+    private void freezeBeforeNative(Context base) {
+        if (CommandLine.isInitialized() || !mEncoded.isEmpty()) {
+            throw new IllegalStateException("ABS_TIMEZONE_COMMAND_LINE_ALREADY_INITIALIZED");
+        }
+        try {
+            ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+            try (InputStream input = base.getAssets().open(ASSET)) {
+                byte[] buffer = new byte[512];
+                int length;
+                while ((length = input.read(buffer)) != -1) {
+                    if (bytes.size() + length > 2048) {
+                        throw new IllegalArgumentException("ABS_TIMEZONE_ASSET_TOO_LARGE");
+                    }
+                    bytes.write(buffer, 0, length);
+                }
+            }
+            byte[] inputBytes = bytes.toByteArray();
+            for (byte value : inputBytes) {
+                if (value < 32 || value > 126) {
+                    throw new IllegalArgumentException("ABS_TIMEZONE_ASSET_NOT_CANONICAL_ASCII");
+                }
+            }
+            String input = new String(inputBytes, StandardCharsets.UTF_8);
+            JSONObject fixture = new JSONObject(input);
+            Object schema = fixture.get("schemaVersion");
+            Object modeValue = fixture.get("mode");
+            Object profileValue = fixture.get("profileId");
+            if (!(schema instanceof Integer) || ((Integer) schema) != 1
+                    || !(modeValue instanceof String) || !(profileValue instanceof String)) {
+                throw new IllegalArgumentException("ABS_TIMEZONE_ASSET_SCHEMA");
+            }
+            String mode = (String) modeValue;
+            mProfileId = (String) profileValue;
+            boolean override = mode.equals("timezone-only");
+            if (!mProfileId.matches(UUID_V4)
+                    || (!override && !mode.equals("native-control"))
+                    || fixture.length() != (override ? 4 : 3)) {
+                throw new IllegalArgumentException("ABS_TIMEZONE_ASSET_FIELDS");
+            }
+            String timezone = "";
+            if (override) {
+                Object timezoneValue = fixture.get("timezone");
+                if (!(timezoneValue instanceof String)) {
+                    throw new IllegalArgumentException("ABS_TIMEZONE_ASSET_TIMEZONE");
+                }
+                timezone = (String) timezoneValue;
+                if (timezone.length() > 128 || !timezone.matches("[A-Za-z0-9/_+\\-]+")) {
+                    throw new IllegalArgumentException("ABS_TIMEZONE_ASSET_TIMEZONE");
+                }
+            }
+            String tail = override ? ",\"timezone\":\"" + timezone + "\"}" : "}";
+            String suffix = "\"mode\":\"" + mode + "\",\"profileId\":\"" + mProfileId
+                    + "\",\"schemaVersion\":1" + tail;
+            if (!input.equals("{" + suffix)) {
+                throw new IllegalArgumentException("ABS_TIMEZONE_ASSET_NOT_CANONICAL_JSON");
+            }
+            String json = "{\"launchId\":\"" + UUID.randomUUID() + "\"," + suffix;
+            byte[] payload = json.getBytes(StandardCharsets.UTF_8);
+            mEncoded = Base64.encodeToString(
+                    payload, Base64.URL_SAFE | Base64.NO_WRAP | Base64.NO_PADDING);
+            CommandLine.init(new String[] {
+                    "agent-browser-timezone-fixture",
+                    "--" + CONFIG_SWITCH + "=" + mEncoded,
+                    "--" + REQUIRED_SWITCH
+            });
+            verifyFrozenCommandLine();
+            byte[] digest = MessageDigest.getInstance("SHA-256").digest(payload);
+            StringBuilder hex = new StringBuilder(64);
+            for (byte value : digest) {
+                hex.append("0123456789abcdef".charAt((value & 255) >>> 4));
+                hex.append("0123456789abcdef".charAt(value & 15));
+            }
+            Log.i(TAG, "ABS_ANDROID_TIMEZONE_V1 frozen=1 input_sha256=%s pid=%d",
+                    hex.toString(), android.os.Process.myPid());
+        } catch (Exception failure) {
+            // No payload, arbitrary exception text, path or Intent values in the receipt.
+            throw new IllegalStateException(
+                    "ABS_TIMEZONE_STARTUP_REJECTED:" + failure.getClass().getSimpleName());
+        }
+    }
+
+    public void verifyFrozenCommandLine() {
+        if (mEncoded.isEmpty() || !CommandLine.isInitialized()
+                || !CommandLine.getInstance().hasSwitch(REQUIRED_SWITCH)
+                || !mEncoded.equals(CommandLine.getInstance().getSwitchValue(CONFIG_SWITCH))
+                || CommandLine.getInstance().hasSwitch("roxy-fingerprint-config")
+                || CommandLine.getInstance().hasSwitch("js-flags")) {
+            throw new IllegalStateException("ABS_TIMEZONE_FROZEN_COMMAND_LINE_CHANGED");
+        }
+    }
+
+    @Override
+    public void initCommandLine() {
+        verifyFrozenCommandLine();  // Never repair or replace a late/missing configuration.
+    }
+
+    @Override
+    protected String getPrivateDataDirectorySuffix() {
+        if (mProfileId.isEmpty()) {
+            throw new IllegalStateException("ABS_TIMEZONE_PROFILE_NOT_FROZEN");
+        }
+        return "abs_timezone_" + mProfileId.replace("-", "");
+    }
+
+    @Override
+    public void onCreate() {
+        if (getPackageName().equals(Application.getProcessName())) {
+            verifyFrozenCommandLine();
+        }
+        super.onCreate();
+    }
+}
