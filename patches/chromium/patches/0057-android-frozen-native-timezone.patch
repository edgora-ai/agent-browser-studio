@@ -0,0 +1,113 @@
+// Copyright 2026 The Agent Browser Studio Authors
+// Use of this source code is governed by a BSD-style license.
+
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_ANDROID)
+#include <string>
+
+#include "base/base64url.h"
+#include "base/command_line.h"
+#include "content/public/common/content_switches.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "content/public/test/content_browser_test.h"
+#include "content/shell/browser/shell.h"
+#include "content/shell/browser/shell_content_browser_client.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "third_party/blink/public/common/agent_browser_android_timezone_config.h"
+#include "third_party/blink/public/common/roxy_fingerprint_config.h"
+
+namespace content {
+namespace {
+
+class AgentBrowserAndroidTimezoneBrowserTest : public ContentBrowserTest {
+ public:
+  static std::string EncodedConfig() {
+    constexpr char kJson[] =
+        "{\"launchId\":\"22222222-2222-4222-8222-222222222222\","
+        "\"mode\":\"timezone-only\","
+        "\"profileId\":\"11111111-1111-4111-8111-111111111111\","
+        "\"schemaVersion\":1,\"timezone\":\"America/New_York\"}";
+    std::string encoded;
+    base::Base64UrlEncode(kJson, base::Base64UrlEncodePolicy::OMIT_PADDING,
+                          &encoded);
+    return encoded;
+  }
+
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    command_line->AppendSwitchASCII(
+        blink::AgentBrowserAndroidTimezoneConfig::kConfigSwitch,
+        EncodedConfig());
+    command_line->AppendSwitch(
+        blink::AgentBrowserAndroidTimezoneConfig::kRequiredSwitch);
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(AgentBrowserAndroidTimezoneBrowserTest,
+                       CopiesExactPayloadOnlyToRendererCommandLines) {
+  ASSERT_TRUE(blink::AgentBrowserAndroidTimezoneConfig::Get().timezone_only());
+  EXPECT_FALSE(blink::RoxyFingerprintConfig::Get().enabled());
+  auto* client = ShellContentBrowserClient::Get();
+  ASSERT_TRUE(client);
+  for (const char* type : {switches::kRendererProcess, switches::kGpuProcess,
+                           switches::kUtilityProcess}) {
+    base::CommandLine child(base::CommandLine::NO_PROGRAM);
+    child.AppendSwitchASCII(switches::kProcessType, type);
+    client->AppendExtraCommandLineSwitches(&child, 0);
+    const bool renderer = std::string_view(type) == switches::kRendererProcess;
+    EXPECT_EQ(renderer, child.HasSwitch(
+        blink::AgentBrowserAndroidTimezoneConfig::kConfigSwitch));
+    EXPECT_EQ(renderer, child.HasSwitch(
+        blink::AgentBrowserAndroidTimezoneConfig::kRequiredSwitch));
+    if (renderer) {
+      EXPECT_EQ(EncodedConfig(), child.GetSwitchValueASCII(
+          blink::AgentBrowserAndroidTimezoneConfig::kConfigSwitch));
+    }
+  }
+}
+
+IN_PROC_BROWSER_TEST_F(AgentBrowserAndroidTimezoneBrowserTest,
+                       NativeWindowAndRecreatedDedicatedWorkers) {
+  embedded_test_server()->ServeFilesFromSourceDirectory("content/test/data");
+  ASSERT_TRUE(embedded_test_server()->Start());
+  ASSERT_TRUE(NavigateToURL(shell(), embedded_test_server()->GetURL("/title1.html")));
+  EXPECT_EQ(true, EvalJs(shell(), R"JS(
+    (async () => {
+      const sample = () => [
+        new Intl.DateTimeFormat().resolvedOptions().timeZone,
+        new Date('2026-01-15T12:00:00Z').getTimezoneOffset(),
+        new Date('2026-07-15T12:00:00Z').getTimezoneOffset()
+      ];
+      const expected = JSON.stringify(['America/New_York', 300, 240]);
+      if (JSON.stringify(sample()) !== expected) return false;
+      const source = 'const first = (' + sample.toString() +
+          ')(); onmessage = () => postMessage(first);';
+      const url = URL.createObjectURL(new Blob([source], {type: 'text/javascript'}));
+      try {
+        for (let i = 0; i < 2; i++) {
+          const value = await new Promise((resolve, reject) => {
+            const worker = new Worker(url);
+            const finish = (result, error) => {
+              clearTimeout(timer);
+              worker.terminate();
+              if (error) reject(new Error(error)); else resolve(result);
+            };
+            const timer = setTimeout(() => finish(null, 'worker timeout'), 5000);
+            worker.onmessage = event => finish(event.data, null);
+            worker.onerror = () => finish(null, 'worker error');
+            worker.postMessage('read first native sample');
+          });
+          if (JSON.stringify(value) !== expected) return false;
+        }
+        return true;
+      } finally {
+        URL.revokeObjectURL(url);
+      }
+    })()
+  )JS"));
+}
+
+}  // namespace
+}  // namespace content
+#endif  // BUILDFLAG(IS_ANDROID)
