+package org.chromium.content_shell_apk;
+
+import android.content.Intent;
+import android.os.Bundle;
+
+/** The fixture cannot accept configuration through initial or subsequent Intents. */
+public final class AgentBrowserTimezoneActivity extends ContentShellActivity {
+    private void validateStartupIntent(Intent intent) {
+        if (intent != null && intent.hasExtra(COMMAND_LINE_ARGS_KEY)) {
+            throw new SecurityException("ABS_TIMEZONE_INTENT_COMMAND_LINE_REJECTED");
+        }
+        ((AgentBrowserTimezoneApplication) getApplication()).verifyFrozenCommandLine();
+    }
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        validateStartupIntent(getIntent());
+        super.onCreate(savedInstanceState);
+    }
+
+    @Override
+    protected void onNewIntent(Intent intent) {
+        validateStartupIntent(intent);
+        super.onNewIntent(intent);
+    }
+}
diff --git a/content/shell/android/shell_apk/src/org/chromium/content_shell_apk/AgentBrowserTimezoneApplication.java b/content/shell/android/shell_apk/src/org/chromium/content_shell_apk/AgentBrowserTimezoneApplication.java
