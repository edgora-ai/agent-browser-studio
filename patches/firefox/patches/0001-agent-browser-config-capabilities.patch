diff --git a/toolkit/xre/AgentBrowserFingerprint.cpp b/toolkit/xre/AgentBrowserFingerprint.cpp
new file mode 100644
index 0000000..efb27a2
--- /dev/null
+++ b/toolkit/xre/AgentBrowserFingerprint.cpp
@@ -0,0 +1,197 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "mozilla/AgentBrowserFingerprint.h"
+
+#include <stdio.h>
+
+#include "mozilla/Base64.h"
+#include "mozilla/Preferences.h"
+#include "mozilla/StaticPtr.h"
+#include "mozilla/dom/ScriptSettings.h"
+#include "js/JSON.h"
+#include "js/PropertyAndElement.h"
+#include "nsTArray.h"
+#include "prenv.h"
+#include "xpcpublic.h"
+#include "mozilla/CmdLineAndEnvUtils.h"
+
+namespace mozilla::agentbrowser {
+
+namespace {
+
+constexpr uint32_t kMaxDecodedConfigLength = 64 * 1024;
+// ceil(65536 * 4 / 3), for unpadded base64url with Reject padding.
+constexpr uint32_t kMaxEncodedConfigLength = 87382;
+
+struct Snapshot final {
+  Snapshot(nsCString&& aEncoded, nsCString&& aDecoded)
+      : mEncoded(std::move(aEncoded)), mDecoded(std::move(aDecoded)) {}
+
+  const nsCString mEncoded;
+  const nsCString mDecoded;
+};
+
+StaticAutoPtr<Snapshot> sSnapshot;
+
+nsresult DecodeConfig(const nsACString& aEncoded, nsCString& aDecoded,
+                      nsACString& aError) {
+  if (aEncoded.IsEmpty()) {
+    aError.AssignLiteral("missing-config");
+    return NS_ERROR_INVALID_ARG;
+  }
+  if (aEncoded.Length() > kMaxEncodedConfigLength) {
+    aError.AssignLiteral("encoded-config-too-large");
+    return NS_ERROR_FILE_TOO_BIG;
+  }
+
+  FallibleTArray<uint8_t> decoded;
+  nsresult rv =
+      Base64URLDecode(aEncoded, Base64URLDecodePaddingPolicy::Reject, decoded);
+  if (NS_FAILED(rv)) {
+    aError.AssignLiteral("invalid-base64url");
+    return rv;
+  }
+  if (decoded.Length() > kMaxDecodedConfigLength) {
+    aError.AssignLiteral("decoded-config-too-large");
+    return NS_ERROR_FILE_TOO_BIG;
+  }
+
+  aDecoded.Assign(reinterpret_cast<const char*>(decoded.Elements()),
+                  decoded.Length());
+  return NS_OK;
+}
+
+nsresult ValidateSchema(const nsACString& aDecoded, nsACString& aError) {
+  dom::AutoJSAPI jsapi;
+  if (!jsapi.Init(xpc::PrivilegedJunkScope())) {
+    aError.AssignLiteral("js-context-unavailable");
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+
+  JSContext* cx = jsapi.cx();
+  NS_ConvertUTF8toUTF16 utf16(aDecoded);
+  JS::Rooted<JS::Value> parsed(cx, JS::NullValue());
+  if (!JS_ParseJSON(cx, utf16.BeginReading(), utf16.Length(), &parsed) ||
+      !parsed.isObject()) {
+    JS_ClearPendingException(cx);
+    aError.AssignLiteral("invalid-json");
+    return NS_ERROR_INVALID_ARG;
+  }
+
+  JS::Rooted<JSObject*> object(cx, &parsed.toObject());
+  JS::Rooted<JS::Value> schemaVersion(cx);
+  if (!JS_GetProperty(cx, object, "schemaVersion", &schemaVersion)) {
+    JS_ClearPendingException(cx);
+    aError.AssignLiteral("missing-schema-version");
+    return NS_ERROR_INVALID_ARG;
+  }
+  if (!schemaVersion.isInt32() || schemaVersion.toInt32() != 1) {
+    aError.AssignLiteral("unsupported-schema-version");
+    return NS_ERROR_INVALID_ARG;
+  }
+
+  return NS_OK;
+}
+
+nsresult InstallSnapshot(nsCString&& aEncoded, nsCString&& aDecoded,
+                         nsACString& aError) {
+  if (sSnapshot) {
+    if (sSnapshot->mEncoded.Equals(aEncoded)) {
+      return NS_OK;
+    }
+    aError.AssignLiteral("snapshot-already-initialized");
+    return NS_ERROR_ALREADY_INITIALIZED;
+  }
+
+  sSnapshot = new Snapshot(std::move(aEncoded), std::move(aDecoded));
+  return NS_OK;
+}
+
+}  // namespace
+
+void DumpCapabilities(const char* aBuildID) {
+  printf(
+      "{\"product\":\"agent-browser-firefox\","
+      "\"capabilitySchemaVersion\":1,"
+      "\"browserVersion\":\"%s\","
+      "\"buildId\":\"%s\","
+      "\"sourceStamp\":\"%s\","
+      "\"capabilities\":[\"config-v1\",\"native-required-v1\","
+      "\"snapshot-v1\"]}\n",
+      MOZ_APP_VERSION, aBuildID ? aBuildID : "", kSourceStamp);
+  fflush(stdout);
+}
+
+nsresult InitializeParent(bool aNativeRequired, nsACString& aError) {
+  aError.Truncate();
+  if (!aNativeRequired) {
+    SaveToEnv("AGENT_BROWSER_FIREFOX_CONFIG=");
+    return NS_OK;
+  }
+
+  nsAutoCString encoded;
+  nsresult rv = Preferences::GetCString(kConfigPref, encoded);
+  if (NS_FAILED(rv) || encoded.IsEmpty()) {
+    aError.AssignLiteral("missing-config");
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+
+  nsAutoCString decoded;
+  rv = DecodeConfig(encoded, decoded, aError);
+  if (NS_FAILED(rv)) {
+    return rv;
+  }
+  rv = ValidateSchema(decoded, aError);
+  if (NS_FAILED(rv)) {
+    return rv;
+  }
+  rv = InstallSnapshot(nsCString(encoded), std::move(decoded), aError);
+  if (NS_FAILED(rv)) {
+    return rv;
+  }
+
+  nsAutoCString environment(kConfigEnvironment);
+  environment.Append('=');
+  environment.Append(encoded);
+  SaveToEnv(environment.get());
+  return NS_OK;
+}
+
+nsresult InitializeChild() {
+  const char* inherited = PR_GetEnv(kConfigEnvironment);
+  if (!inherited || !*inherited) {
+    return NS_OK;
+  }
+
+  nsAutoCString encoded(inherited);
+  nsAutoCString decoded;
+  nsAutoCString error;
+  nsresult rv = DecodeConfig(encoded, decoded, error);
+  if (NS_SUCCEEDED(rv)) {
+    rv = ValidateSchema(decoded, error);
+  }
+  if (NS_SUCCEEDED(rv)) {
+    rv = InstallSnapshot(std::move(encoded), std::move(decoded), error);
+  }
+  if (NS_FAILED(rv)) {
+    fprintf(stderr, "AGENT_BROWSER_NATIVE_CONFIG_ERROR: child-%s\n",
+            error.get());
+  }
+  return rv;
+}
+
+bool IsEnabled() { return sSnapshot != nullptr; }
+
+const nsCString& EncodedConfig() {
+  static const nsCString sEmpty;
+  return sSnapshot ? sSnapshot->mEncoded : sEmpty;
+}
+
+const nsCString& DecodedConfig() {
+  static const nsCString sEmpty;
+  return sSnapshot ? sSnapshot->mDecoded : sEmpty;
+}
+
+}  // namespace mozilla::agentbrowser
