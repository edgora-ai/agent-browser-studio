+bool DeriveCanvasKey(const nsAString& aSeed, std::array<uint8_t, 32>& aKey) {
+  if (aSeed.Length() != 16) {
+    return false;
+  }
+
+  uint64_t hash = 1469598103934665603ULL;
+  for (size_t index = 0; index < aSeed.Length(); ++index) {
+    const char16_t character = aSeed.CharAt(index);
+    if (!((character >= '0' && character <= '9') ||
+          (character >= 'a' && character <= 'f'))) {
+      return false;
+    }
+    hash ^= static_cast<uint8_t>(character);
+    hash *= 1099511628211ULL;
+  }
+
+  for (size_t word = 0; word < 4; ++word) {
+    hash = MixSeed(hash + 0x9e3779b97f4a7c15ULL + word);
+    for (size_t byte = 0; byte < 8; ++byte) {
+      aKey[word * 8 + byte] = static_cast<uint8_t>((hash >> (byte * 8)) & 0xff);
+    }
+  }
+  return true;
+}
