+void MediaDevices::ResolveAgentEnumerateDevicesPromise(
+    Promise* aPromise) const {
+  nsTArray<RefPtr<MediaDeviceInfo>> infos;
+  const auto* config = agentbrowser::GetMediaDevicesOverrides();
+  nsCOMPtr<nsPIDOMWindowInner> window = GetOwnerWindow();
+  if (!config || !window) {
+    aPromise->MaybeResolve(std::move(infos));
+    return;
+  }
+  Document* doc = window->GetExtantDoc();
+  const bool dropMics =
+      !doc || !FeaturePolicyUtils::IsFeatureAllowed(doc, u"microphone"_ns);
+  const bool dropCams =
+      !doc || !FeaturePolicyUtils::IsFeatureAllowed(doc, u"camera"_ns);
+  const bool dropSpeakers =
+      !doc || !Preferences::GetBool("media.setsinkid.enabled") ||
+      !FeaturePolicyUtils::IsFeatureAllowed(doc, u"speaker-selection"_ns);
+  const bool legacy = IsLegacyMode(window);
+  const bool capturePermitted =
+      legacy && MediaManager::Get()->IsActivelyCapturingOrHasAPermission(
+                    window->WindowID());
+
+  // Anonymized ids must be bound to the origin (including origin attributes,
+  // so containers and private windows stay isolated), the profile persona seed
+  // and the window, exactly like the stock per-origin anonymization: stable
+  // across restarts but never correlated across origins or containers.
+  nsAutoCString originKey("agent-browser-media-devices-v1\x1f");
+  if (nsIPrincipal* principal = window->AsGlobal()->PrincipalOrNull()) {
+    nsAutoCString origin;
+    if (NS_SUCCEEDED(principal->GetOrigin(origin))) {
+      originKey.Append(origin);
+    }
+    originKey.Append('\x1f');
+    nsAutoCString originAttributesSuffix;
+    principal->OriginAttributesRef().CreateSuffix(originAttributesSuffix);
+    originKey.Append(originAttributesSuffix);
+    if (origin.IsEmpty() || origin.EqualsLiteral("null")) {
+      // Opaque origins carry no correlatable origin; salt with the window id
+      // so distinct null-principal documents cannot share persona ids.
+      originKey.AppendPrintf("\x1fwindow-%llu",
+                             static_cast<unsigned long long>(window->WindowID()));
+    }
+  }
+  originKey.Append('\x1f');
+  if (const auto* canvas = agentbrowser::GetCanvasOverrides()) {
+    for (uint8_t byte : canvas->mKey) {
+      originKey.AppendPrintf("%02x", byte);
+    }
+  }
+
+  const auto* screen = agentbrowser::GetScreenOverrides();
+  const bool mobile = screen && screen->mMobile;
+
+  auto anonymizedId = [&](const nsString& aRaw) {
+    nsString id(aRaw);
+    if (NS_FAILED(nsContentUtils::AnonymizeId(
+            id, originKey, nsContentUtils::OriginFormat::Plain))) {
+      id.Truncate();
+    }
+    return id;
+  };
+  auto anonymizedGroup = [&](const nsLiteralString& aRaw) {
+    nsString group(aRaw);
+    // Session-salt groups with the window id, mirroring the stock path.
+    group.AppendInt(window->WindowID());
+    if (NS_FAILED(nsContentUtils::AnonymizeId(
+            group, originKey, nsContentUtils::OriginFormat::Plain))) {
+      group.Truncate();
+    }
+    return group;
+  };
+
+  const nsString audioGroup =
+      anonymizedGroup(u"agent-browser-group-audio"_ns);
+  const nsString videoGroup =
+      anonymizedGroup(u"agent-browser-group-video"_ns);
+
+  const bool exposeMic = CanExposeInfo(MediaDeviceKind::Audioinput) || legacy;
+  const bool exposeCam = CanExposeInfo(MediaDeviceKind::Videoinput) || legacy;
+  const bool micLabel = legacy ? capturePermitted : exposeMic;
+  const bool camLabel = legacy ? capturePermitted : exposeCam;
+  // Stock FilterExposedDevices() keeps only the first microphone and camera
+  // when their info cannot be exposed outside legacy mode; the persona roster
+  // applies the same cap so pre-permission enumeration stays stock-shaped.
+  const uint32_t micCount = exposeMic ? config->mAudioInputs
+                                      : std::min(config->mAudioInputs, 1u);
+  const uint32_t camCount = exposeCam ? config->mVideoInputs
+                                      : std::min(config->mVideoInputs, 1u);
+
+  auto appendDevice = [&](MediaDeviceKind aKind, const nsString& aRawId,
+                          const nsString& aGroup, const nsString& aLabel,
+                          bool aExposeInfo, bool aExposeLabel) {
+    nsString id = aExposeInfo ? anonymizedId(aRawId) : u""_ns;
+    infos.AppendElement(MakeRefPtr<MediaDeviceInfo>(
+        id, aKind, aExposeLabel ? aLabel : u""_ns,
+        aExposeInfo ? aGroup : u""_ns));
+  };
+
+  if (!dropMics) {
+    for (uint32_t i = 0; i < micCount; i++) {
+      nsAutoString rawId(u"agent-browser-mic-"_ns);
+      rawId.AppendInt(i);
+      nsAutoString label;
+      if (i == 0) {
+        label = mobile ? u"Microphone"_ns : u"Default - 'default'"_ns;
+      } else {
+        label = u"Microphone ("_ns;
+        label.AppendInt(i + 1);
+        label.Append(u')');
+      }
+      appendDevice(MediaDeviceKind::Audioinput, rawId, audioGroup, label,
+                   exposeMic, micLabel);
+    }
+  }
+  if (!dropCams) {
+    for (uint32_t i = 0; i < camCount; i++) {
+      nsAutoString rawId(u"agent-browser-cam-"_ns);
+      rawId.AppendInt(i);
+      nsAutoString label;
+      if (i == 0) {
+        label =
+            mobile ? u"Rear Camera"_ns : u"FaceTime HD Camera (Built-in)"_ns;
+      } else {
+        label = u"Camera ("_ns;
+        label.AppendInt(i + 1);
+        label.Append(u')');
+      }
+      appendDevice(MediaDeviceKind::Videoinput, rawId, videoGroup, label,
+                   exposeCam, camLabel);
+    }
+  }
+  // Stock exposes outputs when microphone info can be exposed or when the
+  // page holds an explicit selectAudioOutput() grant; the persona roster
+  // mirrors that rule. CanExposeInfo(Audiooutput) is true for every output
+  // that survives the stock filter, and in legacy mode labels stay hidden
+  // until capture is permitted — both gating rules are preserved.
+  if (!dropSpeakers && (mCanExposeMicrophoneInfo ||
+                        !mExplicitlyGrantedAudioOutputRawIds.IsEmpty())) {
+    const bool speakerLabel = legacy ? capturePermitted : true;
+    for (uint32_t i = 0; i < config->mAudioOutputs; i++) {
+      nsAutoString rawId(u"agent-browser-speaker-"_ns);
+      rawId.AppendInt(i);
+      nsAutoString label;
+      if (i == 0) {
+        label = u"Default - 'default'"_ns;
+      } else {
+        label = u"Speaker ("_ns;
+        label.AppendInt(i + 1);
+        label.Append(u')');
+      }
+      appendDevice(MediaDeviceKind::Audiooutput, rawId, audioGroup, label,
+                   true, speakerLabel);
+    }
+  }
+  aPromise->MaybeResolve(std::move(infos));
+}
