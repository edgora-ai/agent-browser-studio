+static const agentbrowser::WebGPUOverrideConfig* AgentOverridesFor(
+    const AdapterInfo& aInfo) {
+  nsIGlobalObject* global = aInfo.GetParentObject();
+  nsIPrincipal* principal = global ? global->PrincipalOrNull() : nullptr;
+  if (!principal || principal->IsSystemPrincipal() ||
+      principal->SchemeIs("chrome") || principal->SchemeIs("resource") ||
+      principal->GetIsAddonOrExpandedAddonPrincipal()) {
+    return nullptr;
+  }
+  return agentbrowser::GetWebGPUOverrides();
+}
+
+void AdapterInfo::GetVendor(nsString& aValue) const {
+  const auto* config = AgentOverridesFor(*this);
+  aValue = config ? config->mVendor : nsString();
+}
+
+void AdapterInfo::GetArchitecture(nsString& aValue) const {
+  const auto* config = AgentOverridesFor(*this);
+  aValue = config ? config->mArchitecture : nsString();
+}
+
+void AdapterInfo::GetDevice(nsString& aValue) const {
+  const auto* config = AgentOverridesFor(*this);
+  aValue = config ? config->mDevice : nsString();
+}
+
+void AdapterInfo::GetDescription(nsString& aValue) const {
+  const auto* config = AgentOverridesFor(*this);
+  aValue = config ? config->mDescription : nsString();
+}
