+bool ShouldApplyAudioNoise(nsIGlobalObject* aGlobal) {
+  const AudioOverrideConfig* config = GetAudioOverrides();
+  if (!config || !config->mEnabled || !aGlobal) {
+    return false;
+  }
+  const auto isUnrestricted = [](nsIPrincipal* aPrincipal) {
+    return !aPrincipal || aPrincipal->IsSystemPrincipal() ||
+           aPrincipal->SchemeIs("chrome") ||
+           aPrincipal->SchemeIs("resource") ||
+           aPrincipal->GetIsAddonOrExpandedAddonPrincipal();
+  };
+  nsIPrincipal* owner = aGlobal->PrincipalOrNull();
+  nsIPrincipal* caller =
+      nsContentUtils::SubjectPrincipalOrSystemIfNativeCaller();
+  return !isUnrestricted(owner) && !isUnrestricted(caller);
+}
+
+static uint64_t AudioNoiseState(const AudioOverrideConfig& aConfig,
+                                uint64_t aDomain, uint64_t aIndex) {
+  uint64_t state = 1469598103934665603ULL;
+  for (uint8_t byte : aConfig.mKey) {
+    state ^= byte;
+    state *= 1099511628211ULL;
+  }
+  state ^= MixSeed(aDomain + 0x9e3779b97f4a7c15ULL);
+  return MixSeed(state + aIndex * 0x9e3779b97f4a7c15ULL);
+}
+
+float AudioNoiseForSample(uint64_t aDomain, uint64_t aIndex, double aScale) {
+  const AudioOverrideConfig* config = GetAudioOverrides();
+  if (!config || !config->mEnabled || !std::isfinite(aScale) || aScale <= 0.0) {
+    return 0.0f;
+  }
+  const uint64_t state = AudioNoiseState(*config, aDomain, aIndex);
+  constexpr double kTwoToMinus53 = 1.0 / 9007199254740992.0;
+  const double unit = static_cast<double>(state >> 11) * kTwoToMinus53;
+  return static_cast<float>((unit * 2.0 - 1.0) * config->mAmplitude * aScale);
+}
+
+int8_t AudioNoiseForByte(uint64_t aDomain, uint64_t aIndex) {
+  const AudioOverrideConfig* config = GetAudioOverrides();
+  if (!config || !config->mEnabled) {
+    return 0;
+  }
+  const uint64_t state = AudioNoiseState(*config, aDomain, aIndex);
+  // Byte readbacks cannot represent sub-LSB amplitude. Preserve the configured
+  // amplitude by scaling the density of deterministic one-LSB changes around
+  // the product default (1e-7), rather than ignoring it.
+  const double density = std::min(1.0, config->mAmplitude / 2.0e-7);
+  constexpr uint64_t kDensityBuckets = 1000000;
+  const uint64_t threshold =
+      static_cast<uint64_t>(density * kDensityBuckets);
+  if (state % kDensityBuckets >= threshold) {
+    return 0;
+  }
+  return (state & (1ULL << 32)) ? 1 : -1;
+}
