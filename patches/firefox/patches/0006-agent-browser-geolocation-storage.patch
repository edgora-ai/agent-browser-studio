+                               const char* aName, double aMinimum,
+                               double aMaximum, double& aResult, bool& aIsNull,
+                               nsACString& aError) {
+  JS::Rooted<JS::Value> value(aCx);
+  if (!GetRequiredProperty(aCx, aObject, aName, &value, aError)) {
+    return false;
+  }
+  if (value.isNull()) {
+    aIsNull = true;
+    aResult = 0.0;
+    return true;
+  }
+  if (!value.isNumber()) {
+    SetInvalidField(aError, aName);
+    return false;
+  }
+  aResult = value.toNumber();
+  aIsNull = false;
+  if (!std::isfinite(aResult) || aResult < aMinimum || aResult > aMaximum) {
+    SetInvalidField(aError, aName);
+    return false;
+  }
+  return true;
+}
+
