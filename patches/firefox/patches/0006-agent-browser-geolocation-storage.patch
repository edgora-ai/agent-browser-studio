+      !value.isNumber()) {
+    SetInvalidField(aError, aName);
+    return false;
+  }
+  const double number = value.toNumber();
+  if (!std::isfinite(number) || number != std::trunc(number) ||
+      number < static_cast<double>(aMinimum) ||
+      number > static_cast<double>(aMaximum)) {
+    SetInvalidField(aError, aName);
+    return false;
+  }
+  aResult = static_cast<uint64_t>(number);
+  return true;
+}
